                            	   890: .macro CHECK_OVERRUN
                            	   891:    # check for overrun
                            	   892:    cmp    r9, 0x20           #only check once per frame
                            	   893:    bne    not_full\@
                            	   894:    btst   r2, DROP_SAMPLE
                            	   895:    bne    not_full\@    #drop pending
                            	   896:    btst   r21, SMI_CTRL_BIT_DMA
                            	   897:    beq  not_dma_overrun\@
                            	   898: 
                            	   899:    ld     r0, (r10) #get dma pointer
                            	   900:    sub    r3, r14, r13  #buffer size
                            	   901:    cmp    r5, r0
                            	   902:    subge  r1, r5, r0
                            	   903:    bge    got_offset_over\@
