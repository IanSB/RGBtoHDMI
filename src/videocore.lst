00:0000076A 46C1C730        	    21M     cmpne r6, (39 - 32)
00:0000076E 01C25E08        	    22M     bseteq r1, 30
00:00000772 46E820000000    	    23M     add   r6, 32
                            	    24M no_status_bytes112:
