                            	    93: .equ IEC958_B_FRAME_PREAMBLE,     0x0f # 0x08 in linux and 0x0f in circle
                            	    94: 
                            	    95: #flag bits  31,30, 17,16 15,14 1,0
                            	    96: .equ FINAL_BIT,            31             #signal if this sample word is the last
                            	    97: #bit 30 is second copy of ALT_MUX_BIT
                            	    98: .equ PSYNC_BIT,            17             #alternates on each full 6 word buffer
                            	    99: .equ ODD_EVEN_BIT_HI,      16             #signal if low or high 16 bit sample is to be used
                            	   100: #bit 15 unused
                            	   101: .equ ALT_MUX_BIT,          14             #moved version of MUX bit also at bit position 30
                            	   102: .equ ODD_EVEN_BIT_LO,      0              #signal if low or high 16 bit sample is to be used
                            	   103: 
                            	   104: .equ DEFAULT_BIT_STATE,    0x00020001     #FINAL_BIT=0, PSYNC_BIT=1, ODD_EVEN_BIT_HI=0, ODD_EVEN_BIT_LO=1
                            	   105: 
                            	   106: #GPIO bits
                            	   107: .equ MUX_BIT,              24             #video input on MUX bit for FFOSD
                            	   108: .equ SYNC_BIT,             23             #sync input
                            	   109: .equ VIDEO_MASK,           0x3ffc         #12bit GPIO mask
                            	   110: 
                            	   111: #command bits
                            	   112: .equ TERMINATE_FLAG,       31
                            	   113: .equ SYNC_ABORT_FLAG,      30
                            	   114: #bits 20-22 are simple sync type
                            	   115: .equ LEADING_SYNC_FLAG,    16
                            	   116: .equ SIMPLE_SYNC_FLAG,     15
                            	   117: .equ HIGH_LATENCY_FLAG,    14
                            	   118: .equ OLD_FIRMWARE_FLAG,    13
                            	   119: 
                            	   120: .equ COMMAND_MASK,         0x00000fff     #masks out command bits that trigger sync detection
                            	   121: #macros
                            	   122: 
                            	   123: .macro    USE_NOP
                            	   124: nop
                            	   125: nop
                            	   126: nop
                            	   127: 
                            	   128: .endm
                            	   129: 
                            	   130: .macro LO_PSYNC_CAPTURE
                            	   131: wait_psync_lo\@:
                            	   132:    ld     r0, (r4)
                            	   133:    USE_NOP
                            	   134:    btst   r0, PSYNC_BIT
                            	   135:    bne    wait_psync_lo\@
                            	   136:    btst   r0, MUX_BIT
                            	   137:    and    r0, r6
                            	   138:    bsetne r0, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   139:    sub    r3, 1
                            	   140:    or     r0, r2           #merge bit state
                            	   141: .endm
                            	   142: 
                            	   143: .macro HI_PSYNC_CAPTURE
                            	   144: wait_psync_hi\@:
                            	   145:    ld     r1, (r4)
                            	   146:    USE_NOP
                            	   147:    btst   r1, PSYNC_BIT
                            	   148:    beq    wait_psync_hi\@
                            	   149:    btst   r1, MUX_BIT
                            	   150:    and    r1, r6
                            	   151:    bsetne r1, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   152:    lsl    r1, 16           #merge lo and hi samples
                            	   153:    cmp    r3, 0
                            	   154:    or     r0, r1
                            	   155: .endm
                            	   156: 
                            	   157: 
                            	   158: .macro OFW_LO_PSYNC_CAPTURE
                            	   159: wait_psync_lo\@:
                            	   160:    ld     r0, (r4)
                            	   161:    USE_NOP
                            	   162:    btst   r0, PSYNC_BIT
                            	   163:    bne    wait_psync_lo\@
                            	   164:    ld     r0, (r4)
                            	   165:    btst   r0, MUX_BIT
                            	   166:    and    r0, r6
                            	   167:    bsetne r0, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   168:    sub    r3, 1
                            	   169:    or     r0, r2           #merge bit state
                            	   170: .endm
                            	   171: 
                            	   172: .macro OFW_HI_PSYNC_CAPTURE
                            	   173: wait_psync_hi\@:
                            	   174:    ld     r1, (r4)
                            	   175:    USE_NOP
                            	   176:    btst   r1, PSYNC_BIT
                            	   177:    beq    wait_psync_hi\@
                            	   178:    ld     r1, (r4)
                            	   179:    btst   r1, MUX_BIT
                            	   180:    and    r1, r6
                            	   181:    bsetne r1, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   182:    lsl    r1, 16           #merge lo and hi samples
                            	   183:    cmp    r3, 0
                            	   184:    or     r0, r1
                            	   185: .endm
                            	   186: 
                            	   187: 
                            	   188: .macro HL_LO_PSYNC_CAPTURE
                            	   189: wait_psync_lo\@:
                            	   190:    ld     r0, (r4)
                            	   191:    USE_NOP
                            	   192:    btst   r0, PSYNC_BIT
                            	   193:    bne    wait_psync_lo\@
                            	   194:    btst   r0, MUX_BIT
                            	   195:    and    r0, r6
                            	   196:    bsetne r0, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   197: 
                            	   198: .endm
                            	   199: 
                            	   200: .macro HL_HI_PSYNC_CAPTURE
                            	   201: wait_psync_hi\@:
                            	   202:    ld     r1, (r4)
                            	   203:    USE_NOP
                            	   204:    btst   r1, PSYNC_BIT
                            	   205:    beq    wait_psync_hi\@
                            	   206:    btst   r1, MUX_BIT
                            	   207:    and    r1, r6
                            	   208:    bsetne r1, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   209:    lsl    r1, 16           #merge lo and hi samples
                            	   210:    or     r0, r1
                            	   211: .endm
                            	   212: 
                            	   213: 
                            	   214: .macro EDGE_DETECT
                            	   215: waitPSE\@:
                            	   216:    ld     r0, (r4)
                            	   217:    USE_NOP
                            	   218:    eor    r0, r2
                            	   219:    btst   r0, PSYNC_BIT
                            	   220:    bne    waitPSE\@
                            	   221:    eor    r0, r2       #restore r0 value
                            	   222:    bchg   r2, PSYNC_BIT
                            	   223: .endm
