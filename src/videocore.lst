                            	   995: increment_error\@:
                            	   996:    add    r22, 1
                            	   997:    bset   r2, LOG_FRAME_ERROR
                            	   998: audio_main_loop\@:
                            	   999: 
                            	  1000:    #capture first sample
                            	  1001:    #LR clock has just gone high
                            	  1002:    btst   r21, SMI_CTRL_BIT_RUN
                            	  1003:    beq    abort_audio            #destination not in macro
                            	  1004: 
                            	  1005:    mov    r3, 24
                            	  1006:    mov    r1, 0
                            	  1007:    mov    r8, 0 #parity count
                            	  1008: firstloop\@:
                            	  1009:    lsl    r1, 1
                            	  1010:    WAIT_FOR_DATA_BIT
                            	  1011:    orne   r1, 1
                            	  1012:    sub    r3, 1
                            	  1013:    cmp    r3, 0
                            	  1014:    bne    firstloop\@
                            	  1015:    lsl    r1, 4
                            	  1016:    btst   r8, 0
                            	  1017:    bsetne r1, 31   # temp set parity bit if count is odd
                            	  1018: 
                            	  1019:    mov    r17, r1   #temp save
                            	  1020: 
                            	  1021:    WAIT_FOR_DATA_BIT
                            	  1022: 
                            	  1023:    CHECK_OVERRUN
                            	  1024: 
                            	  1025:    WAIT_FOR_DATA_BIT
                            	  1026: 
                            	  1027:    cmp    r9, BUFFER_CHECK_COUNT >> 1
                            	  1028:    bne    skip_update\@
                            	  1029:    ld     r21, SMI_CTRL(r20)      #update the control register
                            	  1030: skip_update\@:
                            	  1031: 
                            	  1032:    mov    r3, 4
                            	  1033: firstremain\@:
                            	  1034:    WAIT_FOR_DATA_BIT
                            	  1035:    sub    r3, 1
                            	  1036:    cmp    r3, 0
                            	  1037:    bne    firstremain\@
                            	  1038: 
                            	  1039:    cmp    r9, (BUFFER_CHECK_COUNT >> 1) + 0x10
                            	  1040:    bne    skip_log\@
                            	  1041:    btst   r2, LOG_FRAME_ERROR
                            	  1042:    beq    skip_log\@
                            	  1043:    st     r22, SMI_ERROR_COUNT(r20)
                            	  1044:    bclr   r2, LOG_FRAME_ERROR
                            	  1045: skip_log\@:
                            	  1046: 
                            	  1047:    WAIT_FOR_LR_BIT
                            	  1048:    bne    bad_sync_LR_high1\@
                            	  1049:    WAIT_HI_TWOGPIO_ONLY
                            	  1050: 
                            	  1051:    WAIT_FOR_LR_BIT
                            	  1052:    beq    bad_sync_LR_low1\@
                            	  1053:    mov    r1, r17
                            	  1054:    mov    r11, r1   #save in case of repeat
                            	  1055:    IEC958_STATUS
                            	  1056:    mov    r17, r1
                            	  1057:    WAIT_HI_TWOGPIO_ONLY
                            	  1058: 
                            	  1059:    #capture second sample
                            	  1060:    #LR clock has just gone low
                            	  1061:    mov    r3, 24
                            	  1062:    mov    r1, 0
                            	  1063:    mov    r8, 0 #parity count
                            	  1064: secondloop\@:
                            	  1065:    lsl    r1, 1
                            	  1066:    WAIT_FOR_DATA_BIT
                            	  1067:    orne   r1, 1
                            	  1068:    sub    r3, 1
                            	  1069:    cmp    r3, 0
                            	  1070:    bne    secondloop\@
                            	  1071:    lsl    r1, 4
                            	  1072:    btst   r8, 0
                            	  1073:    bsetne r1, 31   # temp set parity bit if count is odd
                            	  1074:    mov    r24, r1   #temp save
                            	  1075: 
                            	  1076:    WAIT_FOR_DATA_BIT
                            	  1077: 
                            	  1078:    CHECK_UNDERRUN
                            	  1079: 
                            	  1080:    WAIT_FOR_DATA_BIT
                            	  1081: 
                            	  1082:    btst   r2, REPEAT_SAMPLE
                            	  1083:    beq    no_repeat_main\@
                            	  1084:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	  1085:    bclr   r2, REPEAT_SAMPLE
                            	  1086: no_repeat_main\@:
                            	  1087: 
                            	  1088:    mov    r3, 4
                            	  1089: secondremain\@:
                            	  1090:    WAIT_FOR_DATA_BIT
                            	  1091:    sub    r3, 1
                            	  1092:    cmp    r3, 0
                            	  1093:    bne    secondremain\@
                            	  1094: 
                            	  1095:    mov    r1, r24
                            	  1096:    IEC958_STATUS
                            	  1097:    mov    r0, r24
                            	  1098:    mov    r24, r1   #temp save
                            	  1099:    mov    r1, r0
                            	  1100: 
                            	  1101:    WAIT_FOR_LR_BIT
                            	  1102:    beq    bad_sync_LR_low2\@
                            	  1103:    WAIT_HI_TWOGPIO_ONLY
                            	  1104: 
                            	  1105:    WAIT_FOR_LR_BIT
                            	  1106:    bne    bad_sync_LR_high2\@
                            	  1107:    mov    r12, r1   #save in case of repeat
                            	  1108:    WAIT_HI_TWOGPIO_ONLY
                            	  1109: 
                            	  1110:    btst   r2, DROP_SAMPLE
                            	  1111:    bclrne r2, DROP_SAMPLE
                            	  1112:    bne    drop_main\@
                            	  1113: 
                            	  1114:    btst   r21, SMI_CTRL_BIT_MONO_RIGHT
                            	  1115:    movne  r1, r24
                            	  1116:    moveq  r1, r17
                            	  1117:    WRITE
                            	  1118:    btst   r21, SMI_CTRL_BIT_MONO_LEFT
                            	  1119:    movne  r1, r17
                            	  1120:    moveq  r1, r24
                            	  1121:    WRITE
                            	  1122:    add    r6, 1
                            	  1123:    cmp    r6, IEC958_FRAMES_PER_BLOCK
                            	  1124:    movge  r6, 0
                            	  1125: drop_main\@:
                            	  1126:    btst   r2, REPEAT_22Khz
                            	  1127:    beq    no_repeat_sample_main\@
                            	  1128:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	  1129: no_repeat_sample_main\@:
                            	  1130: 
                            	  1131:    add    r9, 1
                            	  1132:    cmp    r9, BUFFER_CHECK_COUNT
                            	  1133:    movge  r9, 0
                            	  1134: 
                            	  1135:    b      audio_main_loop\@
