                            	   113: #flag bits  31,30, 17,16 15,14 1,0
                            	   114: .equ FINAL_BIT,            31             #signal if this sample word is the last
                            	   115: #bit 30 is second copy of ALT_MUX_BIT
                            	   116: .equ PSYNC_BIT,            17             #alternates on each full 6 word buffer
                            	   117: .equ ODD_EVEN_BIT_HI,      16             #signal if low or high 16 bit sample is to be used
                            	   118: #bit 15 unused
                            	   119: .equ ALT_MUX_BIT,          14             #moved version of MUX bit also at bit position 30
                            	   120: .equ ODD_EVEN_BIT_LO,      0              #signal if low or high 16 bit sample is to be used
                            	   121: 
                            	   122: .equ DEFAULT_BIT_STATE,    0x00020001     #FINAL_BIT=0, PSYNC_BIT=1, ODD_EVEN_BIT_HI=0, ODD_EVEN_BIT_LO=1
                            	   123: 
                            	   124: #GPIO bits
                            	   125: .equ MUX_BIT,              24             #video input on MUX bit for FFOSD
                            	   126: .equ SYNC_BIT,             23             #sync input
                            	   127: .equ VIDEO_MASK,           0x3ffc         #12bit GPIO mask
                            	   128: 
                            	   129: #command bits
                            	   130: .equ TERMINATE_FLAG,       31
                            	   131: .equ SYNC_ABORT_FLAG,      30
                            	   132: #bits 20-22 are simple sync type
                            	   133: .equ LEADING_SYNC_FLAG,    16
                            	   134: .equ SIMPLE_SYNC_FLAG,     15
                            	   135: .equ HIGH_LATENCY_FLAG,    14
                            	   136: .equ OLD_FIRMWARE_FLAG,    13
                            	   137: 
                            	   138: .equ COMMAND_MASK,         0x00000fff     #masks out command bits that trigger sync detection
                            	   139: #macros
