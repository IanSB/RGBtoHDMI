                            	   641: #macros for audio capture
                            	   642: .macro DELAY_NOP
                            	   643:    nop
                            	   644:    nop
                            	   645:    nop
                            	   646:    nop
                            	   647:    nop
                            	   648:    nop
                            	   649: 
                            	   650: .endm
                            	   651: 
                            	   652: .macro DELAY_NOP2
                            	   653:    nop
                            	   654:    nop
                            	   655: 
                            	   656: .endm
                            	   657: 
                            	   658: .macro WAIT_EDGE_FOR_DATA_BIT
                            	   659: waitBCH\@:
                            	   660:    ld     r0, (r4)
                            	   661:    DELAY_NOP
                            	   662:    eor    r0, r2
                            	   663:    btst   r0, CLOCK_BIT
                            	   664:    beq    waitBCH\@
                            	   665:    ld     r0, (r4)     #second read for settle delay
                            	   666:    bchg   r2, CLOCK_BIT
                            	   667:    btst   r0, r15 # DATABIT
                            	   668: .endm
                            	   669: 
                            	   670: .macro WAIT_EDGE_FOR_LR_BIT
                            	   671: waitBCH\@:
                            	   672:    ld     r0, (r4)
                            	   673:    DELAY_NOP
                            	   674:    eor    r0, r2
                            	   675:    btst   r0, CLOCK_BIT
                            	   676:    beq    waitBCH\@
                            	   677:    ld     r0, (r4)     #second read for settle delay
                            	   678:    bchg   r2, CLOCK_BIT
                            	   679:    btst   r0, r16 # LRBIT
                            	   680: .endm
                            	   681: 
                            	   682: .macro HI_BITCLK_FOR_DATA_BIT
                            	   683: waitBCH\@:
                            	   684:    ld     r0, (r4)
                            	   685: #   DELAY_NOP2
                            	   686:    btst   r0, CLOCK_BIT
                            	   687:    beq    waitBCH\@
                            	   688:    ld     r0, (r4)     #second read for settle delay
                            	   689:    btst   r0, r15 # DATABIT
                            	   690: 
                            	   691: .endm
                            	   692: 
                            	   693: .macro LO_BITCLK_FOR_LR_BIT
                            	   694: waitBCL\@:
                            	   695:    ld     r0, (r4)
                            	   696: #   DELAY_NOP2
                            	   697:    btst   r0, CLOCK_BIT
                            	   698:    bne    waitBCL\@
                            	   699:    ld     r0, (r4)     #second read for settle delay
                            	   700:    btst   r0, r16 # LRBIT
                            	   701: .endm
                            	   702: 
                            	   703: .macro HI_BITCLK
                            	   704: waitBCHO\@:
                            	   705:    ld     r0, (r4)
                            	   706: #   DELAY_NOP2
                            	   707:    btst   r0, CLOCK_BIT
                            	   708:    beq    waitBCHO\@
                            	   709: .endm
                            	   710: 
                            	   711: .macro LO_BITCLK
                            	   712: waitBCLO\@:
                            	   713:    ld     r0, (r4)
                            	   714: #   DELAY_NOP2
                            	   715:    btst   r0, CLOCK_BIT
                            	   716:    bne    waitBCLO\@
                            	   717: .endm
                            	   718: 
                            	   719: .macro WAIT_FOR_DATA_BIT
                            	   720: .if ONEGPIO == 1
                            	   721:    LO_BITCLK
                            	   722:    HI_BITCLK_FOR_DATA_BIT
                            	   723: .else
                            	   724:    WAIT_EDGE_FOR_DATA_BIT
                            	   725: .endif
                            	   726: .endm
                            	   727: 
                            	   728: .macro WAIT_FOR_LR_BIT
                            	   729: .if ONEGPIO == 1
                            	   730:    LO_BITCLK_FOR_LR_BIT
                            	   731: .else
                            	   732:    WAIT_EDGE_FOR_LR_BIT
                            	   733: .endif
                            	   734: .endm
                            	   735: 
                            	   736: .macro WAIT_HI_ONEGPIO_ONLY
                            	   737: .if ONEGPIO == 1
                            	   738:    HI_BITCLK
                            	   739: .endif
                            	   740: .endm
                            	   741: 
                            	   742: .macro LO_LRCLK
                            	   743: .if ONEGPIO == 1
                            	   744: waitLRCL2\@:
                            	   745:    HI_BITCLK
                            	   746:    LO_BITCLK_FOR_LR_BIT
                            	   747:    bne    waitLRCL2\@
                            	   748:    HI_BITCLK
                            	   749: .else
                            	   750: waitLRCL\@:
                            	   751:    WAIT_EDGE_FOR_LR_BIT
                            	   752:    beq    waitLRCL\@
                            	   753: .endif
                            	   754: .endm
                            	   755: 
                            	   756: 
                            	   757: .macro HI_LRCLK
                            	   758: .if ONEGPIO == 1
                            	   759: waitLRCH2\@:
                            	   760:    HI_BITCLK
                            	   761:    LO_BITCLK_FOR_LR_BIT
                            	   762:    beq    waitLRCH2\@
                            	   763:    HI_BITCLK
                            	   764: .else
                            	   765: waitLRCH\@:
                            	   766:    WAIT_EDGE_FOR_LR_BIT
                            	   767:    bne    waitLRCH\@
                            	   768: .endif
                            	   769: .endm
                            	   770: 
