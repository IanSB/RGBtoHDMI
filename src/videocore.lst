                            	   898: .macro CHECK_UNDERRUN
                            	   899:    # check for underrun
                            	   900:    cmp    r9,0x10
                            	   901:    bne    not_empty\@             #only check once per frame
                            	   902:    btst   r2, REPEAT_SAMPLE
                            	   903:    bne    not_empty\@          #repeat pending
                            	   904: 
                            	   905:    btst   r21, SMI_CTRL_BIT_DMA
                            	   906:    beq  not_dma_underrun\@
                            	   907: 
                            	   908:    ld     r0, (r10) #get dma pointer
                            	   909:    sub    r3, r14, r13  #buffer size
                            	   910:    cmp    r5, r0
                            	   911:    subge  r1, r5, r0
                            	   912:    bge    got_offset_under\@
                            	   913:    sub    r1, r0, r5
                            	   914:    sub    r1, r3, r1
                            	   915: got_offset_under\@:
                            	   916:    lsr    r3, 1
                            	   917:    sub    r1, r3
                            	   918:    st     r1, SMI_DMA_OFFSET(r20)
                            	   919:    rsb    r1, 0
                            	   920:    cmp    r1, MAX_DMA_DRIFT_ERROR
                            	   921:    bgt    repeat_empty\@
                            	   922:    cmp    r1, MAX_DMA_DRIFT
                            	   923:    bgt    empty\@
                            	   924:    b      not_empty\@
                            	   925: 
                            	   926: not_dma_underrun\@:
                            	   927:    ld     r0, (r7)  #read MAI CTL
                            	   928:    btst   r0, HD_MAI_CTL_ERRORE
                            	   929:    bne    repeat_empty_ERRORE\@
                            	   930:    btst   r0, HD_MAI_CTL_EMPTY
                            	   931:    beq    not_empty\@
                            	   932: empty\@:
                            	   933:    btst   r21, SMI_CTRL_BIT_PLL_1
                            	   934:    beq    repeat_empty\@
                            	   935:    btst   r21, SMI_CTRL_BIT_PLL_0
                            	   936:    beq    use_slow_pll_empty\@
                            	   937: 
                            	   938: #   mov    r0, r19
                            	   939: #   sub    r0, PLL_OFFSET_FAST
                            	   940:    sub    r19, PLL_OFFSET_FAST
                            	   941:    mov    r0, r19
                            	   942:    or     r0, CM_PASSWORD
                            	   943:    st     r0, (r18)
                            	   944:    b      not_empty\@
                            	   945: 
                            	   946: use_slow_pll_empty\@:
