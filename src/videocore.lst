                            	  1039: increment_error\@:
                            	  1040:    add    r22, 1
                            	  1041:    bset   r2, LOG_FRAME_ERROR
                            	  1042: audio_main_loop\@:
                            	  1043: 
                            	  1044:    #capture first sample
                            	  1045:    #LR clock has just gone high
                            	  1046:    btst   r21, SMI_CTRL_BIT_RUN
                            	  1047:    beq    abort_audio            #destination not in macro
                            	  1048: 
                            	  1049:    mov    r3, 24
                            	  1050:    mov    r1, 0
                            	  1051:    mov    r8, 0 #parity count
                            	  1052: firstloop\@:
                            	  1053:    lsl    r1, 1
                            	  1054:    WAIT_FOR_DATA_BIT
                            	  1055:    orne   r1, 1
                            	  1056:    sub    r3, 1
                            	  1057:    cmp    r3, 0
                            	  1058:    bne    firstloop\@
                            	  1059:    lsl    r1, 4
                            	  1060:    btst   r8, 0
                            	  1061:    bsetne r1, 31   # temp set parity bit if count is odd
                            	  1062: 
                            	  1063:    mov    r17, r1   #temp save
                            	  1064: 
                            	  1065:    WAIT_FOR_DATA_BIT
                            	  1066: 
                            	  1067:    CHECK_OVERRUN
                            	  1068: 
                            	  1069:    WAIT_FOR_DATA_BIT
                            	  1070: 
                            	  1071:    cmp    r9, BUFFER_CHECK_COUNT >> 1
                            	  1072:    bne    skip_update\@
                            	  1073:    ld     r21, SMI_CTRL(r20)      #update the control register
                            	  1074: skip_update\@:
                            	  1075: 
                            	  1076:    mov    r3, 4
                            	  1077: firstremain\@:
                            	  1078:    WAIT_FOR_DATA_BIT
                            	  1079:    sub    r3, 1
                            	  1080:    cmp    r3, 0
                            	  1081:    bne    firstremain\@
                            	  1082: 
                            	  1083:    cmp    r9, (BUFFER_CHECK_COUNT >> 1) + 0x10
                            	  1084:    bne    skip_log\@
                            	  1085:    btst   r2, LOG_FRAME_ERROR
                            	  1086:    beq    skip_log\@
                            	  1087:    st     r22, SMI_ERROR_COUNT(r20)
                            	  1088:    bclr   r2, LOG_FRAME_ERROR
                            	  1089: skip_log\@:
                            	  1090: 
                            	  1091:    WAIT_FOR_LR_BIT
                            	  1092:    bne    bad_sync_LR_high1\@
                            	  1093:    WAIT_HI_TWOGPIO_ONLY
                            	  1094: 
                            	  1095:    WAIT_FOR_LR_BIT
                            	  1096:    beq    bad_sync_LR_low1\@
                            	  1097:    mov    r1, r17
                            	  1098:    mov    r11, r1   #save in case of repeat
                            	  1099:    IEC958_STATUS
                            	  1100:    mov    r17, r1
                            	  1101:    WAIT_HI_TWOGPIO_ONLY
                            	  1102: 
                            	  1103:    #capture second sample
                            	  1104:    #LR clock has just gone low
                            	  1105:    mov    r3, 24
                            	  1106:    mov    r1, 0
                            	  1107:    mov    r8, 0 #parity count
                            	  1108: secondloop\@:
                            	  1109:    lsl    r1, 1
                            	  1110:    WAIT_FOR_DATA_BIT
                            	  1111:    orne   r1, 1
                            	  1112:    sub    r3, 1
                            	  1113:    cmp    r3, 0
                            	  1114:    bne    secondloop\@
                            	  1115:    lsl    r1, 4
                            	  1116:    btst   r8, 0
                            	  1117:    bsetne r1, 31   # temp set parity bit if count is odd
                            	  1118:    mov    r24, r1   #temp save
                            	  1119: 
                            	  1120:    WAIT_FOR_DATA_BIT
                            	  1121: 
                            	  1122:    CHECK_UNDERRUN
                            	  1123: 
                            	  1124:    WAIT_FOR_DATA_BIT
                            	  1125: 
                            	  1126:    btst   r2, REPEAT_SAMPLE
                            	  1127:    beq    no_repeat_main\@
                            	  1128:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	  1129:    bclr   r2, REPEAT_SAMPLE
                            	  1130: no_repeat_main\@:
                            	  1131: 
                            	  1132:    mov    r3, 4
                            	  1133: secondremain\@:
                            	  1134:    WAIT_FOR_DATA_BIT
                            	  1135:    sub    r3, 1
                            	  1136:    cmp    r3, 0
                            	  1137:    bne    secondremain\@
                            	  1138: 
                            	  1139:    mov    r1, r24
                            	  1140:    IEC958_STATUS
                            	  1141:    mov    r0, r24
                            	  1142:    mov    r24, r1   #temp save
                            	  1143:    mov    r1, r0
                            	  1144: 
                            	  1145:    WAIT_FOR_LR_BIT
                            	  1146:    beq    bad_sync_LR_low2\@
                            	  1147:    WAIT_HI_TWOGPIO_ONLY
                            	  1148: 
                            	  1149:    WAIT_FOR_LR_BIT
                            	  1150:    bne    bad_sync_LR_high2\@
                            	  1151:    mov    r12, r1   #save in case of repeat
                            	  1152:    WAIT_HI_TWOGPIO_ONLY
                            	  1153: 
                            	  1154:    btst   r2, DROP_SAMPLE
                            	  1155:    bclrne r2, DROP_SAMPLE
                            	  1156:    bne    drop_main\@
                            	  1157: 
                            	  1158:    btst   r21, SMI_CTRL_BIT_MONO_RIGHT
                            	  1159:    movne  r1, r24
                            	  1160:    moveq  r1, r17
                            	  1161:    WRITE
                            	  1162:    btst   r21, SMI_CTRL_BIT_MONO_LEFT
                            	  1163:    movne  r1, r17
                            	  1164:    moveq  r1, r24
                            	  1165:    WRITE
                            	  1166:    add    r6, 1
                            	  1167:    cmp    r6, IEC958_FRAMES_PER_BLOCK
                            	  1168:    movge  r6, 0
                            	  1169: drop_main\@:
                            	  1170:    btst   r2, REPEAT_22Khz
                            	  1171:    beq    no_repeat_sample_main\@
                            	  1172:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	  1173: no_repeat_sample_main\@:
                            	  1174: 
                            	  1175:    add    r9, 1
                            	  1176:    cmp    r9, BUFFER_CHECK_COUNT
                            	  1177:    movge  r9, 0
                            	  1178: 
                            	  1179:    b      audio_main_loop\@
