                            	  1001: .macro WRITE_LEFT_RIGHT
                            	  1002:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	  1003:    btst   r2, REPEAT_22Khz
                            	  1004:    beq    no_repeat_sample\@
                            	  1005:    bl     SINGLE_WRITE_LEFT_RIGHT
