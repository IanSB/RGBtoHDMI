                            	   998: .macro CAPTURE_AUDIO
                            	   999:    HI_LRCLK
                            	  1000:    LO_LRCLK
                            	  1001:    b  audio_main_loop\@
                            	  1002: bad_sync_LR_high1\@:
                            	  1003: #WRITE_LEFT_RIGHT  using causes PLL trouble
                            	  1004:    LO_LRCLK
                            	  1005:    WRITE_LEFT_RIGHT
                            	  1006:    b  increment_error\@
                            	  1007: 
                            	  1008: bad_sync_LR_low1\@:
