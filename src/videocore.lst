                            	   989: .macro WRITE_LEFT_RIGHT
                            	   990:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	   991:    btst   r2, REPEAT_22Khz
                            	   992:    beq    no_repeat_sample\@
                            	   993:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	   994: no_repeat_sample\@:
