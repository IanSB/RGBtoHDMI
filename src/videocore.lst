                            	   922:    btst   r0, HD_MAI_CTL_ERRORF
                            	   923:    bne    drop_full\@
                            	   924:    btst   r0, HD_MAI_CTL_FULL
                            	   925:    beq    not_full\@
                            	   926: full\@:
                            	   927:    btst   r21, SMI_CTRL_BIT_PLL_1
                            	   928:    beq    drop_full\@
                            	   929:    btst   r21, SMI_CTRL_BIT_PLL_0
                            	   930:    beq    use_slow_pll_full\@
                            	   931: 
                            	   932: #   mov    r0, r19
                            	   933: #   add    r0, PLL_OFFSET_FAST
                            	   934:    add    r19, PLL_OFFSET_FAST
                            	   935:    mov    r0, r19
                            	   936:    or     r0, CM_PASSWORD
                            	   937:    st     r0, (r18)
                            	   938:    b      not_full\@
                            	   939: 
                            	   940: use_slow_pll_full\@:
