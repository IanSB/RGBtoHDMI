                            	   860: .macro CHECK_UNDERRUN
                            	   861:    # check for underrun
                            	   862:    cmp    r9,0x10
                            	   863:    bne    not_empty\@             #only check once per frame
                            	   864:    btst   r2, REPEAT_SAMPLE
                            	   865:    bne    not_empty\@          #repeat pending
                            	   866: 
                            	   867:    btst   r21, SMI_CTRL_BIT_DMA
                            	   868:    beq  not_dma_underrun\@
                            	   869: 
                            	   870:    ld     r0, (r10) #get dma pointer
                            	   871:    sub    r3, r14, r13  #buffer size
                            	   872:    cmp    r5, r0
                            	   873:    subge  r1, r5, r0
                            	   874:    bge    got_offset_under\@
                            	   875:    sub    r1, r0, r5
                            	   876:    sub    r1, r3, r1
                            	   877: got_offset_under\@:
                            	   878:    lsr    r3, 1
                            	   879:    sub    r1, r3
                            	   880:    st     r1, SMI_DMA_OFFSET(r20)
                            	   881:    rsb    r1, 0
                            	   882:    cmp    r1, MAX_DMA_DRIFT_ERROR
                            	   883:    bgt    repeat_empty\@
                            	   884:    cmp    r1, MAX_DMA_DRIFT
                            	   885:    bgt    empty\@
                            	   886:    b      not_empty\@
                            	   887: 
                            	   888: not_dma_underrun\@:
                            	   889:    ld     r0, (r7)  #read MAI CTL
                            	   890:    btst   r0, HD_MAI_CTL_ERRORE
                            	   891:    bne    repeat_empty_ERRORE\@
                            	   892:    btst   r0, HD_MAI_CTL_EMPTY
                            	   893:    beq    not_empty\@
                            	   894: empty\@:
                            	   895:    btst   r21, SMI_CTRL_BIT_PLL_1
                            	   896:    beq    repeat_empty\@
                            	   897:    btst   r21, SMI_CTRL_BIT_PLL_0
                            	   898:    beq    use_slow_pll_empty\@
                            	   899: 
                            	   900: #   mov    r0, r19
                            	   901: #   sub    r0, PLL_OFFSET_FAST
                            	   902:    sub    r19, PLL_OFFSET_FAST
                            	   903:    mov    r0, r19
                            	   904:    or     r0, CM_PASSWORD
                            	   905:    st     r0, (r18)
                            	   906:    b      not_empty\@
                            	   907: 
                            	   908: use_slow_pll_empty\@:
                            	   909:    sub    r19, PLL_OFFSET_SLOW
                            	   910:    mov    r0, r19
                            	   911:    or     r0, CM_PASSWORD
                            	   912:    st     r0, (r18)
                            	   913:    b      not_empty\@
                            	   914: 
                            	   915: repeat_empty_ERRORE\@:
                            	   916:    mov    r0, (1 << HD_MAI_CTL_RST_MAI) | (1 << HD_MAI_CTL_ERRORF) | (1 << HD_MAI_CTL_ERRORE) | (1 << HD_MAI_CTL_DLATE)
                            	   917:    st     r0, (r7)    #clear ERRORE
                            	   918:    mov    r0, (1 << HD_MAI_CTL_ENABLE) | (2 << HD_MAI_CTL_CHNUM) | (1 << HD_MAI_CTL_WHOLSMP) | (1 << HD_MAI_CTL_CHALIGN
                            	   919:    st     r0, (r7)        
                            	   920: repeat_empty\@:
                            	   921:    bset   r2, REPEAT_SAMPLE
                            	   922:    add    r23, 0x10000
                            	   923:    bclr   r23, 31   #max 32767
                            	   924:    st     r23, SMI_DROP_REPEAT_COUNT(r20)
                            	   925: not_empty\@:
                            	   926: 
                            	   927: .endm
                            	   928: 
                            	   929: .macro CHECK_OVERRUN
                            	   930:    # check for overrun
                            	   931:    cmp    r9, 0x20           #only check once per frame
                            	   932:    bne    not_full\@
                            	   933:    btst   r2, DROP_SAMPLE
                            	   934:    bne    not_full\@    #drop pending
                            	   935:    btst   r21, SMI_CTRL_BIT_DMA
                            	   936:    beq  not_dma_overrun\@
                            	   937: 
                            	   938:    ld     r0, (r10) #get dma pointer
                            	   939:    sub    r3, r14, r13  #buffer size
                            	   940:    cmp    r5, r0
                            	   941:    subge  r1, r5, r0
                            	   942:    bge    got_offset_over\@
                            	   943:    sub    r1, r0, r5
                            	   944:    sub    r1, r3, r1
                            	   945: got_offset_over\@:
                            	   946:    lsr    r3, 1
                            	   947:    sub    r1, r3
                            	   948:    st     r1, SMI_DMA_OFFSET(r20)
                            	   949:    cmp    r1, MAX_DMA_DRIFT_ERROR
                            	   950:    bgt    drop_full\@
                            	   951:    cmp    r1, MAX_DMA_DRIFT
                            	   952:    bgt    full\@
                            	   953:    b      not_full\@
                            	   954: 
                            	   955: not_dma_overrun\@:
                            	   956:    ld     r0, (r7)  #read MAI CTL
                            	   957:    btst   r0, HD_MAI_CTL_ERRORF
                            	   958:    bne    drop_full_ERRORF\@
                            	   959:    btst   r0, HD_MAI_CTL_FULL
                            	   960:    beq    not_full\@
                            	   961: full\@:
                            	   962:    btst   r21, SMI_CTRL_BIT_PLL_1
                            	   963:    beq    drop_full\@
                            	   964:    btst   r21, SMI_CTRL_BIT_PLL_0
                            	   965:    beq    use_slow_pll_full\@
                            	   966: 
                            	   967: #   mov    r0, r19
                            	   968: #   add    r0, PLL_OFFSET_FAST
                            	   969:    add    r19, PLL_OFFSET_FAST
                            	   970:    mov    r0, r19
                            	   971:    or     r0, CM_PASSWORD
                            	   972:    st     r0, (r18)
                            	   973:    b      not_full\@
                            	   974: 
                            	   975: use_slow_pll_full\@:
                            	   976:    add    r19, PLL_OFFSET_SLOW
                            	   977:    mov    r0, r19
                            	   978:    or     r0, CM_PASSWORD
                            	   979:    st     r0, (r18)
                            	   980:    b      not_full\@
                            	   981: drop_full_ERRORF\@:
                            	   982:    mov    r0, (1 << HD_MAI_CTL_RST_MAI) | (1 << HD_MAI_CTL_ERRORF) | (1 << HD_MAI_CTL_ERRORE) | (1 << HD_MAI_CTL_DLATE)
                            	   983:    st     r0, (r7)    #clear ERRORF
                            	   984:    mov    r0, (1 << HD_MAI_CTL_ENABLE) | (2 << HD_MAI_CTL_CHNUM) | (1 << HD_MAI_CTL_WHOLSMP) | (1 << HD_MAI_CTL_CHALIGN
                            	   985:    st     r0, (r7)        
                            	   986: drop_full\@:
                            	   987:    bset   r2, DROP_SAMPLE
                            	   988:    add    r23, 1
                            	   989:    bclr   r23, 15  #max 32767
                            	   990:    st     r23, SMI_DROP_REPEAT_COUNT(r20)
                            	   991: not_full\@:
                            	   992: 
                            	   993: .endm
