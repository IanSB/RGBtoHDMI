                            	   830: .macro CHECK_UNDERRUN
                            	   831:    # check for underrun
                            	   832:    cmp    r9,0x10
                            	   833:    bne    not_empty\@             #only check once per frame
                            	   834:    btst   r2, REPEAT_SAMPLE
                            	   835:    bne    not_empty\@          #repeat pending
                            	   836: 
                            	   837:    btst   r21, SMI_CTRL_BIT_DMA
                            	   838:    beq  not_dma_underrun\@
                            	   839: 
                            	   840:    ld     r0, (r10) #get dma pointer
                            	   841:    sub    r3, r14, r13  #buffer size
                            	   842:    cmp    r5, r0
                            	   843:    subge  r1, r5, r0
                            	   844:    bge    got_offset_under\@
                            	   845:    sub    r1, r0, r5
                            	   846:    sub    r1, r3, r1
                            	   847: got_offset_under\@:
                            	   848:    lsr    r3, 1
                            	   849:    sub    r1, r3
                            	   850:    st     r1, SMI_DMA_OFFSET(r20)
                            	   851:    rsb    r1, 0
                            	   852:    cmp    r1, MAX_DMA_DRIFT_ERROR
                            	   853:    bgt    repeat_empty\@
                            	   854:    cmp    r1, MAX_DMA_DRIFT
                            	   855:    bgt    empty\@
                            	   856:    b      not_empty\@
                            	   857: 
                            	   858: not_dma_underrun\@:
                            	   859:    ld     r0, (r7)  #read MAI CTL
                            	   860:    btst   r0, HD_MAI_CTL_ERRORE
                            	   861:    bne    repeat_empty\@
                            	   862:    btst   r0, HD_MAI_CTL_EMPTY
                            	   863:    beq    not_empty\@
                            	   864: empty\@:
                            	   865:    btst   r21, SMI_CTRL_BIT_PLL_1
                            	   866:    beq    repeat_empty\@
                            	   867:    btst   r21, SMI_CTRL_BIT_PLL_0
                            	   868:    beq    use_slow_pll_empty\@
                            	   869: 
                            	   870: #   mov    r0, r19
                            	   871: #   sub    r0, PLL_OFFSET_FAST
                            	   872:    sub    r19, PLL_OFFSET_FAST
                            	   873:    mov    r0, r19
                            	   874:    or     r0, CM_PASSWORD
                            	   875:    st     r0, (r18)
                            	   876:    b      not_empty\@
                            	   877: 
                            	   878: use_slow_pll_empty\@:
                            	   879:    sub    r19, PLL_OFFSET_SLOW
                            	   880:    mov    r0, r19
                            	   881:    or     r0, CM_PASSWORD
                            	   882:    st     r0, (r18)
                            	   883:    b      not_empty\@
                            	   884: 
                            	   885: repeat_empty\@:
                            	   886:    bset   r2, REPEAT_SAMPLE
                            	   887:    add    r23, 0x10000
                            	   888:    bclr   r23, 31   #max 32767
                            	   889:    st     r23, SMI_DROP_REPEAT_COUNT(r20)
                            	   890: not_empty\@:
                            	   891: 
                            	   892: .endm
                            	   893: 
                            	   894: .macro CHECK_OVERRUN
                            	   895:    # check for overrun
                            	   896:    cmp    r9, 0x20           #only check once per frame
                            	   897:    bne    not_full\@
                            	   898:    btst   r2, DROP_SAMPLE
                            	   899:    bne    not_full\@    #drop pending
                            	   900:    btst   r21, SMI_CTRL_BIT_DMA
                            	   901:    beq  not_dma_overrun\@
                            	   902: 
                            	   903:    ld     r0, (r10) #get dma pointer
                            	   904:    sub    r3, r14, r13  #buffer size
                            	   905:    cmp    r5, r0
                            	   906:    subge  r1, r5, r0
                            	   907:    bge    got_offset_over\@
                            	   908:    sub    r1, r0, r5
                            	   909:    sub    r1, r3, r1
                            	   910: got_offset_over\@:
                            	   911:    lsr    r3, 1
                            	   912:    sub    r1, r3
                            	   913:    st     r1, SMI_DMA_OFFSET(r20)
                            	   914:    cmp    r1, MAX_DMA_DRIFT_ERROR
