                            	   968: .macro CHECK_OVERRUN
                            	   969:    # check for overrun
                            	   970:    cmp    r9, 0x20           #only check once per frame
                            	   971:    bne    not_full\@
                            	   972:    btst   r2, DROP_SAMPLE
                            	   973:    bne    not_full\@    #drop pending
                            	   974:    btst   r21, SMI_CTRL_BIT_DMA
                            	   975:    beq  not_dma_overrun\@
                            	   976: 
                            	   977:    ld     r0, (r10) #get dma pointer
                            	   978:    sub    r3, r14, r13  #buffer size
