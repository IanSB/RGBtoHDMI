                            	  1144: vpu1:
                            	  1145: audio_capture:
00:0000085A 9203            	  1146:    push   r0-r18,lr
                            	  1147: 
                            	  1148:    #r0 = gpio value
                            	  1149:    #r1 = sample value
                            	  1150:    #r2 = flags reg
                            	  1151:    #r3 = counter
                            	  1152:    #r4 = gpio address
                            	  1153:    #r5 = sample pointer
                            	  1154:    #r6 = frame counter
                            	  1155:    #r7 = MAI_CTRL pointer
                            	  1156:    #r8 = parity count
                            	  1157:    #r9 = overrun/underrun check counter
                            	  1158:    #r10 = DMA0POINTER
                            	  1159:    #r11 = copy of first sample
                            	  1160:    #r12 = copy of second sample
                            	  1161:    #r13 = low end of dma buffer
                            	  1162:    #r14 = high end of dma buffer
                            	  1163:    #r15 = audio data pin
                            	  1164:    #r16 = audio LR pin
                            	  1165:    #r17 = temp save reg
                            	  1166:    #r18 = pointer to PLLD FRAC register
                            	  1167:    #r19 = original value of PLLD FRAC register
                            	  1168:    #r20 = pointer to SMI register block used for ARM communications
                            	  1169:    #r21 = current value of ARM control register
                            	  1170:    #r22 = frame error count
                            	  1171:    #r23 = drop and repeat counts (15 bits each)
                            	  1172:    #r24 = temp save reg
                            	  1173: 
                            	  1174: # on entry r1 = audio_data_pin, r2 = audio_LR_pin, r3 = sample_repeat)
00:0000085C 1F40            	  1175:    mov   r15, r1
00:0000085E 10C00287        	  1176:    mov   r16, r2
00:00000862 3240            	  1177:    mov   r2, r3
                            	  1178: 
00:00000864 14E81000607E    	  1179:    mov    r20, SMI_BASE
00:0000086A 0AE80C70007E    	  1180:    mov    r10, DMA0POINTER
                            	  1181: 
00:00000870 04E83400207E    	  1182:    mov    r4, GPLEV0
00:00000876 07E81480807E    	  1183:    mov    r7, HD_MAI_CTL
                            	  1184: 
00:0000087C 12E84022107E    	  1185:    mov    r18, PLLD_FRAC
                            	  1186: 
                            	  1187: #   mov    r0, (1 << CLOCK_BIT)
                            	  1188: #   st     r0, (GPREN0-GPLEV0)(r4)   #enable rising edge detection
                            	  1189: #   st     r0, (GPFEN0-GPLEV0)(r4)   #enable falling edge detection
                            	  1190: 
                            	  1191: #   mov r1, INTEN
                            	  1192: #   ld  r0, (r1)
                            	  1193: #   or  r0, (1 << 17)
                            	  1194: #   st  r0, (r1)
                            	  1195: 
                            	  1196:   # Acknowledge the interrupt
                            	  1197:   #  ld     r0, (GPEDS0-GPLEV0)(r4)
                            	  1198:   #  st     r0, (GPEDS0-GPLEV0)(r4)
