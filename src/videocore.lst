                            	  1068:    btst   r8, 0
                            	  1069:    bsetne r1, 31   # temp set parity bit if count is odd
                            	  1070:    mov    r24, r1   #temp save
                            	  1071: 
                            	  1072:    WAIT_FOR_DATA_BIT
                            	  1073: 
                            	  1074:    CHECK_UNDERRUN
                            	  1075: 
                            	  1076:    WAIT_FOR_DATA_BIT
                            	  1077: 
                            	  1078:    btst   r2, REPEAT_SAMPLE
                            	  1079:    beq    no_repeat_main\@
                            	  1080:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	  1081:    bclr   r2, REPEAT_SAMPLE
                            	  1082: no_repeat_main\@:
                            	  1083: 
                            	  1084:    mov    r3, 4
                            	  1085: secondremain\@:
                            	  1086:    WAIT_FOR_DATA_BIT
                            	  1087:    sub    r3, 1
                            	  1088:    cmp    r3, 0
                            	  1089:    bne    secondremain\@
