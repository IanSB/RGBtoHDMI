                            	   141: .macro    USE_NOP
                            	   142: nop
                            	   143: nop
                            	   144: nop
                            	   145: 
                            	   146: .endm
                            	   147: 
                            	   148: .macro LO_PSYNC_CAPTURE
                            	   149: wait_psync_lo\@:
                            	   150:    ld     r0, (r4)
                            	   151:    USE_NOP
                            	   152:    btst   r0, PSYNC_BIT
                            	   153:    bne    wait_psync_lo\@
                            	   154:    btst   r0, MUX_BIT
                            	   155:    and    r0, r6
                            	   156:    bsetne r0, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   157:    sub    r3, 1
                            	   158:    or     r0, r2           #merge bit state
                            	   159: .endm
                            	   160: 
                            	   161: .macro HI_PSYNC_CAPTURE
                            	   162: wait_psync_hi\@:
                            	   163:    ld     r1, (r4)
                            	   164:    USE_NOP
                            	   165:    btst   r1, PSYNC_BIT
                            	   166:    beq    wait_psync_hi\@
                            	   167:    btst   r1, MUX_BIT
                            	   168:    and    r1, r6
                            	   169:    bsetne r1, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   170:    lsl    r1, 16           #merge lo and hi samples
                            	   171:    cmp    r3, 0
                            	   172:    or     r0, r1
                            	   173: .endm
                            	   174: 
                            	   175: 
                            	   176: .macro OFW_LO_PSYNC_CAPTURE
                            	   177: wait_psync_lo\@:
                            	   178:    ld     r0, (r4)
                            	   179:    USE_NOP
                            	   180:    btst   r0, PSYNC_BIT
                            	   181:    bne    wait_psync_lo\@
                            	   182:    ld     r0, (r4)
                            	   183:    btst   r0, MUX_BIT
                            	   184:    and    r0, r6
                            	   185:    bsetne r0, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   186:    sub    r3, 1
                            	   187:    or     r0, r2           #merge bit state
                            	   188: .endm
                            	   189: 
                            	   190: .macro OFW_HI_PSYNC_CAPTURE
                            	   191: wait_psync_hi\@:
                            	   192:    ld     r1, (r4)
                            	   193:    USE_NOP
                            	   194:    btst   r1, PSYNC_BIT
                            	   195:    beq    wait_psync_hi\@
                            	   196:    ld     r1, (r4)
                            	   197:    btst   r1, MUX_BIT
                            	   198:    and    r1, r6
                            	   199:    bsetne r1, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   200:    lsl    r1, 16           #merge lo and hi samples
                            	   201:    cmp    r3, 0
                            	   202:    or     r0, r1
                            	   203: .endm
                            	   204: 
                            	   205: 
                            	   206: .macro HL_LO_PSYNC_CAPTURE
                            	   207: wait_psync_lo\@:
                            	   208:    ld     r0, (r4)
                            	   209:    USE_NOP
                            	   210:    btst   r0, PSYNC_BIT
                            	   211:    bne    wait_psync_lo\@
                            	   212:    btst   r0, MUX_BIT
                            	   213:    and    r0, r6
                            	   214:    bsetne r0, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   215: 
                            	   216: .endm
                            	   217: 
                            	   218: .macro HL_HI_PSYNC_CAPTURE
                            	   219: wait_psync_hi\@:
                            	   220:    ld     r1, (r4)
                            	   221:    USE_NOP
                            	   222:    btst   r1, PSYNC_BIT
                            	   223:    beq    wait_psync_hi\@
                            	   224:    btst   r1, MUX_BIT
                            	   225:    and    r1, r6
                            	   226:    bsetne r1, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   227:    lsl    r1, 16           #merge lo and hi samples
                            	   228:    or     r0, r1
                            	   229: .endm
                            	   230: 
                            	   231: 
                            	   232: .macro EDGE_DETECT
                            	   233: waitPSE\@:
                            	   234:    ld     r0, (r4)
                            	   235:    USE_NOP
                            	   236:    eor    r0, r2
                            	   237:    btst   r0, PSYNC_BIT
                            	   238:    bne    waitPSE\@
                            	   239:    eor    r0, r2       #restore r0 value
                            	   240:    bchg   r2, PSYNC_BIT
                            	   241: .endm
