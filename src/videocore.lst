                            	   630: #macros for audio capture
                            	   631: .macro DELAY_NOP
                            	   632:    nop
                            	   633:    nop
                            	   634:    nop
                            	   635:    nop
                            	   636: 
                            	   637: .endm
                            	   638: 
                            	   639: 
                            	   640: .macro WAIT_EDGE_FOR_DATA_BIT
                            	   641: waitBCH\@:
                            	   642:    DELAY_NOP
                            	   643:    ld     r0, (r4)
                            	   644:    eor    r0, r2
                            	   645:    btst   r0, CLOCK_BIT
                            	   646:    beq    waitBCH\@
                            	   647:    ld     r0, (r4)          #second read for reliability
                            	   648:    bchg   r2, CLOCK_BIT     #edge detect if using 3 gpios otherwise high detect
                            	   649:    btst   r0, r15 # DATABIT
                            	   650:    addne  r8, 1  #parity count
                            	   651: .endm
                            	   652: 
                            	   653: .macro WAIT_EDGE_FOR_LR_BIT
                            	   654: waitBCH\@:
                            	   655:    DELAY_NOP
                            	   656:    ld     r0, (r4)
                            	   657:    eor    r0, r2
                            	   658:    btst   r0, CLOCK_BIT
                            	   659:    beq    waitBCH\@
                            	   660:    ld     r0, (r4)          #second read for reliability
                            	   661:    bchg   r2, CLOCK_BIT     #edge detect if using 3 gpios otherwise high detect
                            	   662:    btst   r0, r16 # LRBIT
                            	   663: .endm
                            	   664: 
                            	   665: 
                            	   666: .macro LO_BITCLK
                            	   667: waitBCL\@:
                            	   668:    ld     r0, (r4)
                            	   669:    btst   r0, CLOCK_BIT
                            	   670:    beq    waitBCL\@
                            	   671: .endm
                            	   672: 
                            	   673: .macro HI_BITCLK_FOR_DATA_BIT
                            	   674: waitBCH\@:
                            	   675:    ld     r0, (r4)
                            	   676:    btst   r0, CLOCK_BIT
                            	   677:    bne    waitBCH\@
                            	   678:    ld     r0, (r4)          #second read for reliability
                            	   679:    btst   r0, r15 # DATABIT
                            	   680:    addne  r8, 1  #parity count
                            	   681: .endm
                            	   682: 
                            	   683: .macro LO_BITCLK_FOR_LR_BIT
                            	   684: waitBCL\@:
                            	   685:    ld     r0, (r4)
                            	   686:    btst   r0, CLOCK_BIT
                            	   687:    beq    waitBCL\@
                            	   688:    ld     r0, (r4)   #second read for delay to allow LR to stabilise in two gpio mode
                            	   689:    btst   r0, r16 # LRBIT
                            	   690: .endm
                            	   691: 
                            	   692: 
                            	   693: 
                            	   694: .macro HI_BITCLK
                            	   695: waitBCHO\@:
                            	   696:    ld     r0, (r4)
                            	   697:    btst   r0, CLOCK_BIT
                            	   698:    bne    waitBCHO\@
                            	   699: .endm
                            	   700: 
                            	   701: .macro WAIT_FOR_DATA_BIT
                            	   702: .if TWOGPIO == 1
                            	   703:    LO_BITCLK
                            	   704:    HI_BITCLK_FOR_DATA_BIT
                            	   705: .else
                            	   706:    WAIT_EDGE_FOR_DATA_BIT
                            	   707: .endif
                            	   708: .endm
                            	   709: 
                            	   710: .macro WAIT_FOR_LR_BIT
                            	   711: .if TWOGPIO == 1
                            	   712:    LO_BITCLK_FOR_LR_BIT
                            	   713: .else
                            	   714:    WAIT_EDGE_FOR_LR_BIT
                            	   715: .endif
                            	   716: .endm
                            	   717: 
                            	   718: .macro WAIT_HI_TWOGPIO_ONLY
                            	   719: .if TWOGPIO == 1
                            	   720:    HI_BITCLK
                            	   721: .endif
                            	   722: .endm
                            	   723: 
                            	   724: .macro LO_LRCLK
                            	   725: .if TWOGPIO == 1
                            	   726: waitLRCL2\@:
                            	   727:    HI_BITCLK
                            	   728:    LO_BITCLK_FOR_LR_BIT
                            	   729:    bne    waitLRCL2\@
                            	   730:    HI_BITCLK
                            	   731: .else
                            	   732: waitLRCL\@:
                            	   733:    WAIT_EDGE_FOR_LR_BIT
                            	   734:    bne    waitLRCL\@
                            	   735: .endif
                            	   736: .endm
                            	   737: 
                            	   738: 
                            	   739: .macro HI_LRCLK
                            	   740: .if TWOGPIO == 1
                            	   741: waitLRCH2\@:
                            	   742:    HI_BITCLK
                            	   743:    LO_BITCLK_FOR_LR_BIT
                            	   744:    beq    waitLRCH2\@
                            	   745:    HI_BITCLK
                            	   746: .else
                            	   747: waitLRCH\@:
                            	   748:    WAIT_EDGE_FOR_LR_BIT
                            	   749:    beq    waitLRCH\@
                            	   750: .endif
                            	   751: .endm
                            	   752: 
