                            	  1190: vpu1:
                            	  1191: audio_capture:
00:0000085A 9203            	  1192:    push   r0-r18,lr
                            	  1193: 
                            	  1194:    #r0 = gpio value
                            	  1195:    #r1 = sample value
                            	  1196:    #r2 = flags reg
                            	  1197:    #r3 = counter
                            	  1198:    #r4 = gpio address
                            	  1199:    #r5 = sample pointer
                            	  1200:    #r6 = frame counter
                            	  1201:    #r7 = MAI_CTRL pointer
                            	  1202:    #r8 = parity count
                            	  1203:    #r9 = overrun/underrun check counter
                            	  1204:    #r10 = DMA0POINTER
                            	  1205:    #r11 = copy of first sample
                            	  1206:    #r12 = copy of second sample
                            	  1207:    #r13 = low end of dma buffer
                            	  1208:    #r14 = high end of dma buffer
