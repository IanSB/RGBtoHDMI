                            	   105: 
                            	   106: #flag bits  31,30, 17,16 15,14 1,0
                            	   107: .equ FINAL_BIT,            31             #signal if this sample word is the last
                            	   108: #bit 30 is second copy of ALT_MUX_BIT
                            	   109: .equ PSYNC_BIT,            17             #alternates on each full 6 word buffer
                            	   110: .equ ODD_EVEN_BIT_HI,      16             #signal if low or high 16 bit sample is to be used
                            	   111: #bit 15 unused
                            	   112: .equ ALT_MUX_BIT,          14             #moved version of MUX bit also at bit position 30
                            	   113: .equ ODD_EVEN_BIT_LO,      0              #signal if low or high 16 bit sample is to be used
                            	   114: 
                            	   115: .equ DEFAULT_BIT_STATE,    0x00020001     #FINAL_BIT=0, PSYNC_BIT=1, ODD_EVEN_BIT_HI=0, ODD_EVEN_BIT_LO=1
                            	   116: 
                            	   117: #GPIO bits
                            	   118: .equ MUX_BIT,              24             #video input on MUX bit for FFOSD
                            	   119: .equ SYNC_BIT,             23             #sync input
                            	   120: .equ VIDEO_MASK,           0x3ffc         #12bit GPIO mask
                            	   121: 
                            	   122: #command bits
                            	   123: .equ TERMINATE_FLAG,       31
                            	   124: .equ SYNC_ABORT_FLAG,      30
                            	   125: #bits 20-22 are simple sync type
                            	   126: .equ LEADING_SYNC_FLAG,    16
                            	   127: .equ SIMPLE_SYNC_FLAG,     15
                            	   128: .equ HIGH_LATENCY_FLAG,    14
                            	   129: .equ OLD_FIRMWARE_FLAG,    13
                            	   130: 
                            	   131: .equ COMMAND_MASK,         0x00000fff     #masks out command bits that trigger sync detection
                            	   132: #macros
                            	   133: 
                            	   134: .macro    USE_NOP
                            	   135: nop
                            	   136: nop
                            	   137: nop
                            	   138: 
                            	   139: .endm
                            	   140: 
                            	   141: .macro LO_PSYNC_CAPTURE
                            	   142: wait_psync_lo\@:
                            	   143:    ld     r0, (r4)
                            	   144:    USE_NOP
                            	   145:    btst   r0, PSYNC_BIT
                            	   146:    bne    wait_psync_lo\@
                            	   147:    btst   r0, MUX_BIT
                            	   148:    and    r0, r6
                            	   149:    bsetne r0, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   150:    sub    r3, 1
                            	   151:    or     r0, r2           #merge bit state
                            	   152: .endm
                            	   153: 
                            	   154: .macro HI_PSYNC_CAPTURE
                            	   155: wait_psync_hi\@:
                            	   156:    ld     r1, (r4)
                            	   157:    USE_NOP
                            	   158:    btst   r1, PSYNC_BIT
                            	   159:    beq    wait_psync_hi\@
                            	   160:    btst   r1, MUX_BIT
                            	   161:    and    r1, r6
                            	   162:    bsetne r1, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   163:    lsl    r1, 16           #merge lo and hi samples
                            	   164:    cmp    r3, 0
                            	   165:    or     r0, r1
                            	   166: .endm
                            	   167: 
                            	   168: 
                            	   169: .macro OFW_LO_PSYNC_CAPTURE
                            	   170: wait_psync_lo\@:
                            	   171:    ld     r0, (r4)
                            	   172:    USE_NOP
                            	   173:    btst   r0, PSYNC_BIT
                            	   174:    bne    wait_psync_lo\@
                            	   175:    ld     r0, (r4)
                            	   176:    btst   r0, MUX_BIT
                            	   177:    and    r0, r6
                            	   178:    bsetne r0, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   179:    sub    r3, 1
                            	   180:    or     r0, r2           #merge bit state
                            	   181: .endm
                            	   182: 
                            	   183: .macro OFW_HI_PSYNC_CAPTURE
                            	   184: wait_psync_hi\@:
                            	   185:    ld     r1, (r4)
                            	   186:    USE_NOP
                            	   187:    btst   r1, PSYNC_BIT
                            	   188:    beq    wait_psync_hi\@
                            	   189:    ld     r1, (r4)
                            	   190:    btst   r1, MUX_BIT
                            	   191:    and    r1, r6
                            	   192:    bsetne r1, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   193:    lsl    r1, 16           #merge lo and hi samples
                            	   194:    cmp    r3, 0
                            	   195:    or     r0, r1
                            	   196: .endm
                            	   197: 
                            	   198: 
                            	   199: .macro HL_LO_PSYNC_CAPTURE
                            	   200: wait_psync_lo\@:
                            	   201:    ld     r0, (r4)
                            	   202:    USE_NOP
                            	   203:    btst   r0, PSYNC_BIT
                            	   204:    bne    wait_psync_lo\@
                            	   205:    btst   r0, MUX_BIT
                            	   206:    and    r0, r6
                            	   207:    bsetne r0, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   208: 
                            	   209: .endm
                            	   210: 
                            	   211: .macro HL_HI_PSYNC_CAPTURE
                            	   212: wait_psync_hi\@:
                            	   213:    ld     r1, (r4)
                            	   214:    USE_NOP
                            	   215:    btst   r1, PSYNC_BIT
                            	   216:    beq    wait_psync_hi\@
                            	   217:    btst   r1, MUX_BIT
                            	   218:    and    r1, r6
                            	   219:    bsetne r1, ALT_MUX_BIT  #move mux bit to position in 16 bit sample
                            	   220:    lsl    r1, 16           #merge lo and hi samples
                            	   221:    or     r0, r1
                            	   222: .endm
                            	   223: 
                            	   224: 
                            	   225: .macro EDGE_DETECT
                            	   226: waitPSE\@:
                            	   227:    ld     r0, (r4)
                            	   228:    USE_NOP
                            	   229:    eor    r0, r2
                            	   230:    btst   r0, PSYNC_BIT
                            	   231:    bne    waitPSE\@
                            	   232:    eor    r0, r2       #restore r0 value
                            	   233:    bchg   r2, PSYNC_BIT
                            	   234: .endm
