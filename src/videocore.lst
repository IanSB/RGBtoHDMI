                            	   666: #macros for audio capture
                            	   667: .macro DELAY_NOP
                            	   668:    nop
                            	   669:    nop
                            	   670:    nop
                            	   671:    nop
                            	   672:    nop
                            	   673:    nop
                            	   674: 
                            	   675: .endm
                            	   676: 
                            	   677: .macro DELAY_NOP2
                            	   678:    nop
                            	   679:    nop
                            	   680: 
                            	   681: .endm
                            	   682: 
                            	   683: .if INTERRUPTS
                            	   684: 
                            	   685: .macro WAIT_EDGE_FOR_DATA_BIT
                            	   686: waitBCH\@:
                            	   687:    btst   r27, 31
                            	   688:    beq    waitBCH\@
                            	   689:    bclr   r27, 31
                            	   690:    mov    r0, r27
                            	   691:    btst   r0, r15 # DATABIT
                            	   692: .endm
                            	   693: 
                            	   694: .macro WAIT_EDGE_FOR_LR_BIT
                            	   695: waitBCH\@:
                            	   696:    btst   r27, 31
                            	   697:    beq    waitBCH\@
                            	   698:    bclr   r27, 31
                            	   699:    mov    r0, r27
                            	   700:    btst   r0, r16 # LRBIT
                            	   701: .endm
                            	   702: 
                            	   703: .else
                            	   704: 
                            	   705: .macro WAIT_EDGE_FOR_DATA_BIT
                            	   706: waitBCH\@:
                            	   707:    ld     r0, (r4)
                            	   708:    DELAY_NOP
                            	   709:    eor    r0, r2
                            	   710:    btst   r0, CLOCK_BIT
                            	   711:    beq    waitBCH\@
                            	   712:    ld     r0, (r4)     #second read for settle delay
                            	   713:    bchg   r2, CLOCK_BIT
                            	   714:    btst   r0, r15 # DATABIT
                            	   715: .endm
                            	   716: 
                            	   717: .macro WAIT_EDGE_FOR_LR_BIT
                            	   718: waitBCH\@:
                            	   719:    ld     r0, (r4)
                            	   720:    DELAY_NOP
                            	   721:    eor    r0, r2
                            	   722:    btst   r0, CLOCK_BIT
                            	   723:    beq    waitBCH\@
                            	   724:    ld     r0, (r4)     #second read for settle delay
                            	   725:    bchg   r2, CLOCK_BIT
                            	   726:    btst   r0, r16
                            	   727: .endm
                            	   728: 
                            	   729: .endif
                            	   730: 
                            	   731: 
                            	   732: .macro HI_BITCLK_FOR_DATA_BIT
                            	   733: waitBCH\@:
                            	   734:    ld     r0, (r4)
                            	   735: #   DELAY_NOP2
                            	   736:    btst   r0, CLOCK_BIT
                            	   737:    beq    waitBCH\@
                            	   738:    ld     r0, (r4)     #second read for settle delay
                            	   739:    btst   r0, r15
                            	   740: 
                            	   741: .endm
                            	   742: 
                            	   743: .macro LO_BITCLK_FOR_LR_BIT
                            	   744: waitBCL\@:
                            	   745:    ld     r0, (r4)
                            	   746: #   DELAY_NOP2
                            	   747:    btst   r0, CLOCK_BIT
                            	   748:    bne    waitBCL\@
                            	   749:    ld     r0, (r4)     #second read for settle delay
                            	   750:    btst   r0, r16
                            	   751: .endm
                            	   752: 
                            	   753: .macro HI_BITCLK
                            	   754: waitBCHO\@:
                            	   755:    ld     r0, (r4)
                            	   756: #   DELAY_NOP2
                            	   757:    btst   r0, CLOCK_BIT
                            	   758:    beq    waitBCHO\@
                            	   759: .endm
                            	   760: 
                            	   761: .macro LO_BITCLK
                            	   762: waitBCLO\@:
                            	   763:    ld     r0, (r4)
                            	   764: #   DELAY_NOP2
                            	   765:    btst   r0, CLOCK_BIT
                            	   766:    bne    waitBCLO\@
                            	   767: .endm
                            	   768: 
                            	   769: .macro WAIT_FOR_DATA_BIT
                            	   770: .if ONEGPIO
                            	   771:    LO_BITCLK
                            	   772:    HI_BITCLK_FOR_DATA_BIT
                            	   773: .else
                            	   774:    WAIT_EDGE_FOR_DATA_BIT
                            	   775: .endif
                            	   776: .endm
                            	   777: 
                            	   778: .macro WAIT_FOR_LR_BIT
                            	   779: .if ONEGPIO
                            	   780:    LO_BITCLK_FOR_LR_BIT
                            	   781: .else
                            	   782:    WAIT_EDGE_FOR_LR_BIT
                            	   783: .endif
                            	   784: .endm
                            	   785: 
                            	   786: .macro WAIT_HI_ONEGPIO_ONLY
                            	   787: .if ONEGPIO
                            	   788:    HI_BITCLK
                            	   789: .endif
                            	   790: .endm
                            	   791: 
                            	   792: .macro LO_LRCLK
                            	   793: .if ONEGPIO
                            	   794: waitLRCL2\@:
                            	   795:    HI_BITCLK
                            	   796:    LO_BITCLK_FOR_LR_BIT
                            	   797:    bne    waitLRCL2\@
                            	   798:    HI_BITCLK
                            	   799: .else
                            	   800: waitLRCL\@:
                            	   801:    WAIT_EDGE_FOR_LR_BIT
                            	   802:    beq    waitLRCL\@
                            	   803: .endif
                            	   804: .endm
                            	   805: 
                            	   806: 
                            	   807: .macro HI_LRCLK
                            	   808: .if ONEGPIO
                            	   809: waitLRCH2\@:
                            	   810:    HI_BITCLK
                            	   811:    LO_BITCLK_FOR_LR_BIT
                            	   812:    beq    waitLRCH2\@
                            	   813:    HI_BITCLK
                            	   814: .else
                            	   815: waitLRCH\@:
                            	   816:    WAIT_EDGE_FOR_LR_BIT
                            	   817:    bne    waitLRCH\@
                            	   818: .endif
                            	   819: .endm
                            	   820: 
                            	   821: 
                            	   822: 
                            	   823: 
                            	   824: .macro IEC958_STATUS
                            	   825: 
                            	   826:     #byte 0 = 0x04   - bits 0-7,   bit 2 set   // consumer, PCM, no copyright, no pre-emphasis
                            	   827:     #byte 1 = 0x00   - bits 8-15                // category (general mode)
                            	   828:     #byte 2 = 0x00   - bits 16-23              // source number, take no account of channel number
                            	   829:     #byte 3 = 0x02   - bits 24-31  bit 25 set    // sampling frequency uchFS = 2 = 48000
                            	   830:     #byte 4 = 0xDB   - bits 32-39  0b1011 | (13 << 4) bits 1101 1011   bits 32, 33, 35, 36, 38, 39      // 24 bit sampl
                            	   831: 
                            	   832:     cmp    r6, 0
                            	   833:     oreq   r1, IEC958_B_FRAME_PREAMBLE
                            	   834:     cmp r6, (IEC958_STATUS_BYTES * 8)
                            	   835:     bge    no_status_bytes\@
                            	   836:     cmp   r6, 2
                            	   837:     cmpne r6, 25
                            	   838:     bseteq r1, 30
                            	   839:     sub   r6, 32
                            	   840:     cmp   r6, (32 - 32)
                            	   841:     cmpne r6, (33 - 32)
                            	   842:     cmpne r6, (35 - 32)
                            	   843:     cmpne r6, (36 - 32)
                            	   844:     cmpne r6, (38 - 32)
                            	   845:     cmpne r6, (39 - 32)
                            	   846:     bseteq r1, 30
                            	   847:     add   r6, 32
                            	   848: no_status_bytes\@:
                            	   849:     mov    r8, 0
                            	   850:     btst   r1, 31  #test existing parity count
                            	   851:     movne  r8, 1
                            	   852:     bclr   r1, 31
                            	   853: 
                            	   854:     btst   r1, 0
                            	   855:     addne  r8, 1
                            	   856:     btst   r1, 1
                            	   857:     addne  r8, 1
                            	   858:     btst   r1, 2
                            	   859:     addne  r8, 1
                            	   860:     btst   r1, 3
                            	   861:     addne  r8, 1
                            	   862:     btst   r1, 28
                            	   863:     addne  r8, 1
                            	   864:     btst   r1, 29
                            	   865:     addne  r8, 1
                            	   866:     btst   r1, 30
                            	   867:     addne  r8, 1
                            	   868: 
                            	   869:     btst   r8, 0
                            	   870:     bsetne r1, 31   # set parity bit as count is odd
                            	   871: 
                            	   872: .endm
                            	   873: 
                            	   874: .macro WRITE
                            	   875:     st     r1, (r5)
                            	   876: #increment buffer pointer
                            	   877:     add    r5, 4
                            	   878:     cmp    r5, r14
                            	   879:     movge  r5, r13
                            	   880: .endm
                            	   881: 
                            	   882: SINGLE_WRITE_LEFT_RIGHT:
00:00000736 95C145AF        	   883:    btst   r21, SMI_CTRL_BIT_MONO_RIGHT
00:0000073A 01C08C08        	   884:    movne  r1, r12
00:0000073E 01C00B08        	   885:    moveq  r1, r11
                            	   886:    IEC958_STATUS
                            	     1M 
                            	     2M     #byte 0 = 0x04   - bits 0-7,   bit 2 set   // consumer, PCM, no copyright, no pre-emphasis
                            	     3M     #byte 1 = 0x00   - bits 8-15                // category (general mode)
                            	     4M     #byte 2 = 0x00   - bits 16-23              // source number, take no account of channel number
                            	     5M     #byte 3 = 0x02   - bits 24-31  bit 25 set    // sampling frequency uchFS = 2 = 48000
                            	     6M     #byte 4 = 0xDB   - bits 32-39  0b1011 | (13 << 4) bits 1101 1011   bits 32, 33, 35, 36, 38, 39      // 24 bit sampl
