                            	  1021:    mov    r0, (1 << HD_MAI_CTL_RST_MAI) | (1 << HD_MAI_CTL_ERRORF) | (1 << HD_MAI_CTL_ERRORE) | (1 << HD_MAI_CTL_DLATE)
                            	  1022:    st     r0, (r7)    #clear ERRORF
                            	  1023:    mov    r0, (1 << HD_MAI_CTL_ENABLE) | (2 << HD_MAI_CTL_CHNUM) | (1 << HD_MAI_CTL_WHOLSMP) | (1 << HD_MAI_CTL_CHALIGN
                            	  1024:    st     r0, (r7)
                            	  1025:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	  1026:    bset   r2, REPEAT_SAMPLE #as buffer flushed
                            	  1027:    b      dont_drop\@
                            	  1028: drop_full\@:
                            	  1029:    bset   r2, DROP_SAMPLE
                            	  1030: dont_drop\@:
