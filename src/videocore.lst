                            	  1027: increment_error\@:
                            	  1028:    add    r22, 1
                            	  1029:    bset   r2, LOG_FRAME_ERROR
                            	  1030: audio_main_loop\@:
                            	  1031: 
                            	  1032:    #capture first sample
                            	  1033:    #LR clock has just gone high
                            	  1034:    btst   r21, SMI_CTRL_BIT_RUN
                            	  1035:    beq    abort_audio            #destination not in macro
                            	  1036: 
                            	  1037:    mov    r3, 24
                            	  1038:    mov    r1, 0
                            	  1039:    mov    r8, 0 #parity count
                            	  1040: firstloop\@:
                            	  1041:    lsl    r1, 1
                            	  1042:    WAIT_FOR_DATA_BIT
                            	  1043: .if ONEGPIO == 1
                            	  1044:    addne  r8, 1  #parity count
                            	  1045:    orne   r1, 1
                            	  1046: .else
                            	  1047:    addeq  r8, 1  #parity count
                            	  1048:    oreq   r1, 1
                            	  1049: .endif
                            	  1050:    sub    r3, 1
                            	  1051:    cmp    r3, 0
                            	  1052:    bne    firstloop\@
                            	  1053:    lsl    r1, 4
                            	  1054:    btst   r8, 0
                            	  1055:    bsetne r1, 31   # temp set parity bit if count is odd
                            	  1056: 
                            	  1057:    mov    r17, r1   #temp save
                            	  1058: 
                            	  1059:    WAIT_FOR_DATA_BIT
                            	  1060: 
                            	  1061:    CHECK_OVERRUN
                            	  1062: 
                            	  1063:    WAIT_FOR_DATA_BIT
                            	  1064: 
                            	  1065:    cmp    r9, BUFFER_CHECK_COUNT >> 1
                            	  1066:    bne    skip_update\@
                            	  1067:    ld     r21, SMI_CTRL(r20)      #update the control register
                            	  1068: skip_update\@:
                            	  1069: 
                            	  1070:    mov    r3, 4
                            	  1071: firstremain\@:
                            	  1072:    WAIT_FOR_DATA_BIT
                            	  1073:    sub    r3, 1
                            	  1074:    cmp    r3, 0
                            	  1075:    bne    firstremain\@
                            	  1076: 
                            	  1077:    cmp    r9, (BUFFER_CHECK_COUNT >> 1) + 0x10
                            	  1078:    bne    skip_log\@
                            	  1079:    btst   r2, LOG_FRAME_ERROR
                            	  1080:    beq    skip_log\@
                            	  1081:    st     r22, SMI_ERROR_COUNT(r20)
                            	  1082:    bclr   r2, LOG_FRAME_ERROR
                            	  1083: skip_log\@:
                            	  1084: 
                            	  1085:    WAIT_FOR_LR_BIT
                            	  1086: .if ONEGPIO == 1
                            	  1087:    bne    bad_sync_LR_high1\@
                            	  1088: .else
                            	  1089:    beq    bad_sync_LR_high1\@
                            	  1090: .endif
                            	  1091:    WAIT_HI_ONEGPIO_ONLY
                            	  1092: 
                            	  1093:    WAIT_FOR_LR_BIT
                            	  1094: .if ONEGPIO == 1
                            	  1095:    beq    bad_sync_LR_low1\@
                            	  1096: .else
                            	  1097:    bne    bad_sync_LR_low1\@
                            	  1098: .endif
                            	  1099:    mov    r1, r17
                            	  1100:    mov    r11, r1   #save in case of repeat
                            	  1101:    IEC958_STATUS
                            	  1102:    mov    r17, r1
                            	  1103:    WAIT_HI_ONEGPIO_ONLY
                            	  1104: 
                            	  1105:    #capture second sample
                            	  1106:    #LR clock has just gone low
                            	  1107:    mov    r3, 24
                            	  1108:    mov    r1, 0
                            	  1109:    mov    r8, 0 #parity count
                            	  1110: secondloop\@:
                            	  1111:    lsl    r1, 1
                            	  1112:    WAIT_FOR_DATA_BIT
                            	  1113: .if ONEGPIO == 1
                            	  1114:    addne  r8, 1  #parity count
                            	  1115:    orne   r1, 1
                            	  1116: .else
                            	  1117:    addeq  r8, 1  #parity count
                            	  1118:    oreq   r1, 1
                            	  1119: .endif
                            	  1120:    sub    r3, 1
                            	  1121:    cmp    r3, 0
                            	  1122:    bne    secondloop\@
                            	  1123:    lsl    r1, 4
                            	  1124:    btst   r8, 0
                            	  1125:    bsetne r1, 31   # temp set parity bit if count is odd
                            	  1126:    mov    r24, r1   #temp save
                            	  1127: 
                            	  1128:    WAIT_FOR_DATA_BIT
                            	  1129: 
                            	  1130:    CHECK_UNDERRUN
                            	  1131: 
                            	  1132:    WAIT_FOR_DATA_BIT
                            	  1133: 
                            	  1134:    btst   r2, REPEAT_SAMPLE
                            	  1135:    beq    no_repeat_main\@
                            	  1136:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	  1137:    bclr   r2, REPEAT_SAMPLE
                            	  1138: no_repeat_main\@:
                            	  1139: 
                            	  1140:    mov    r3, 4
                            	  1141: secondremain\@:
                            	  1142:    WAIT_FOR_DATA_BIT
                            	  1143:    sub    r3, 1
                            	  1144:    cmp    r3, 0
                            	  1145:    bne    secondremain\@
                            	  1146: 
                            	  1147:    mov    r1, r24
                            	  1148:    IEC958_STATUS
                            	  1149:    mov    r0, r24
                            	  1150:    mov    r24, r1   #temp save
                            	  1151:    mov    r1, r0
                            	  1152: 
                            	  1153:    WAIT_FOR_LR_BIT
                            	  1154: .if ONEGPIO == 1
                            	  1155:    beq    bad_sync_LR_low2\@
                            	  1156: .else
                            	  1157:    bne    bad_sync_LR_low2\@
                            	  1158: .endif
                            	  1159: 
                            	  1160:    WAIT_HI_ONEGPIO_ONLY
                            	  1161: 
                            	  1162:    WAIT_FOR_LR_BIT
                            	  1163: .if ONEGPIO == 1
                            	  1164:    bne    bad_sync_LR_high2\@
                            	  1165: .else
                            	  1166:    beq    bad_sync_LR_high2\@
                            	  1167: .endif
                            	  1168:    mov    r12, r1   #save in case of repeat
                            	  1169:    WAIT_HI_ONEGPIO_ONLY
                            	  1170: 
                            	  1171:    btst   r2, DROP_SAMPLE
                            	  1172:    bclrne r2, DROP_SAMPLE
                            	  1173:    bne    drop_main\@
                            	  1174: 
                            	  1175:    btst   r21, SMI_CTRL_BIT_MONO_RIGHT
                            	  1176:    movne  r1, r24
                            	  1177:    moveq  r1, r17
                            	  1178:    WRITE
                            	  1179:    btst   r21, SMI_CTRL_BIT_MONO_LEFT
                            	  1180:    movne  r1, r17
                            	  1181:    moveq  r1, r24
                            	  1182:    WRITE
                            	  1183:    add    r6, 1
                            	  1184:    cmp    r6, IEC958_FRAMES_PER_BLOCK
                            	  1185:    movge  r6, 0
                            	  1186: drop_main\@:
                            	  1187:    btst   r2, REPEAT_22Khz
                            	  1188:    beq    no_repeat_sample_main\@
                            	  1189:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	  1190: no_repeat_sample_main\@:
                            	  1191: 
                            	  1192:    add    r9, 1
                            	  1193:    cmp    r9, BUFFER_CHECK_COUNT
                            	  1194:    movge  r9, 0
                            	  1195: 
                            	  1196:    b      audio_main_loop\@
