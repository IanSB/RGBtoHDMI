                            	   848: .macro CHECK_UNDERRUN
                            	   849:    # check for underrun
                            	   850:    cmp    r9,0x10
                            	   851:    bne    not_empty\@             #only check once per frame
                            	   852:    btst   r2, REPEAT_SAMPLE
                            	   853:    bne    not_empty\@          #repeat pending
                            	   854: 
                            	   855:    btst   r21, SMI_CTRL_BIT_DMA
                            	   856:    beq  not_dma_underrun\@
                            	   857: 
                            	   858:    ld     r0, (r10) #get dma pointer
                            	   859:    sub    r3, r14, r13  #buffer size
                            	   860:    cmp    r5, r0
                            	   861:    subge  r1, r5, r0
                            	   862:    bge    got_offset_under\@
                            	   863:    sub    r1, r0, r5
                            	   864:    sub    r1, r3, r1
                            	   865: got_offset_under\@:
                            	   866:    lsr    r3, 1
                            	   867:    sub    r1, r3
                            	   868:    st     r1, SMI_DMA_OFFSET(r20)
                            	   869:    rsb    r1, 0
                            	   870:    cmp    r1, MAX_DMA_DRIFT_ERROR
                            	   871:    bgt    repeat_empty\@
                            	   872:    cmp    r1, MAX_DMA_DRIFT
                            	   873:    bgt    empty\@
                            	   874:    b      not_empty\@
                            	   875: 
                            	   876: not_dma_underrun\@:
                            	   877:    ld     r0, (r7)  #read MAI CTL
                            	   878:    btst   r0, HD_MAI_CTL_ERRORE
                            	   879:    bne    repeat_empty_ERRORE\@
                            	   880:    btst   r0, HD_MAI_CTL_EMPTY
                            	   881:    beq    not_empty\@
                            	   882: empty\@:
                            	   883:    btst   r21, SMI_CTRL_BIT_PLL_1
                            	   884:    beq    repeat_empty\@
                            	   885:    btst   r21, SMI_CTRL_BIT_PLL_0
                            	   886:    beq    use_slow_pll_empty\@
                            	   887: 
                            	   888: #   mov    r0, r19
                            	   889: #   sub    r0, PLL_OFFSET_FAST
                            	   890:    sub    r19, PLL_OFFSET_FAST
                            	   891:    mov    r0, r19
                            	   892:    or     r0, CM_PASSWORD
                            	   893:    st     r0, (r18)
                            	   894:    b      not_empty\@
                            	   895: 
                            	   896: use_slow_pll_empty\@:
                            	   897:    sub    r19, PLL_OFFSET_SLOW
                            	   898:    mov    r0, r19
                            	   899:    or     r0, CM_PASSWORD
                            	   900:    st     r0, (r18)
                            	   901:    b      not_empty\@
                            	   902: 
                            	   903: repeat_empty_ERRORE\@:
                            	   904:    mov    r0, (1 << HD_MAI_CTL_RST_MAI) | (1 << HD_MAI_CTL_ERRORF) | (1 << HD_MAI_CTL_ERRORE) | (1 << HD_MAI_CTL_DLATE)
                            	   905:    st     r0, (r7)    #clear ERRORE
                            	   906:    mov    r0, (1 << HD_MAI_CTL_ENABLE) | (2 << HD_MAI_CTL_CHNUM) | (1 << HD_MAI_CTL_WHOLSMP) | (1 << HD_MAI_CTL_CHALIGN
                            	   907:    st     r0, (r7)
                            	   908:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	   909: repeat_empty\@:
                            	   910:    bset   r2, REPEAT_SAMPLE
                            	   911:    add    r23, 0x10000
                            	   912:    bclr   r23, 31   #max 32767
                            	   913:    st     r23, SMI_DROP_REPEAT_COUNT(r20)
                            	   914: not_empty\@:
                            	   915: 
                            	   916: .endm
                            	   917: 
                            	   918: .macro CHECK_OVERRUN
                            	   919:    # check for overrun
                            	   920:    cmp    r9, 0x20           #only check once per frame
                            	   921:    bne    not_full\@
                            	   922:    btst   r2, DROP_SAMPLE
                            	   923:    bne    not_full\@    #drop pending
                            	   924:    btst   r21, SMI_CTRL_BIT_DMA
                            	   925:    beq  not_dma_overrun\@
                            	   926: 
                            	   927:    ld     r0, (r10) #get dma pointer
                            	   928:    sub    r3, r14, r13  #buffer size
                            	   929:    cmp    r5, r0
                            	   930:    subge  r1, r5, r0
                            	   931:    bge    got_offset_over\@
                            	   932:    sub    r1, r0, r5
                            	   933:    sub    r1, r3, r1
                            	   934: got_offset_over\@:
                            	   935:    lsr    r3, 1
                            	   936:    sub    r1, r3
                            	   937:    st     r1, SMI_DMA_OFFSET(r20)
                            	   938:    cmp    r1, MAX_DMA_DRIFT_ERROR
                            	   939:    bgt    drop_full\@
                            	   940:    cmp    r1, MAX_DMA_DRIFT
                            	   941:    bgt    full\@
                            	   942:    b      not_full\@
                            	   943: 
                            	   944: not_dma_overrun\@:
                            	   945:    ld     r0, (r7)  #read MAI CTL
                            	   946:    btst   r0, HD_MAI_CTL_ERRORF
                            	   947:    bne    drop_full_ERRORF\@
                            	   948:    btst   r0, HD_MAI_CTL_FULL
                            	   949:    beq    not_full\@
                            	   950: full\@:
                            	   951:    btst   r21, SMI_CTRL_BIT_PLL_1
                            	   952:    beq    drop_full\@
                            	   953:    btst   r21, SMI_CTRL_BIT_PLL_0
                            	   954:    beq    use_slow_pll_full\@
                            	   955: 
                            	   956: #   mov    r0, r19
                            	   957: #   add    r0, PLL_OFFSET_FAST
                            	   958:    add    r19, PLL_OFFSET_FAST
                            	   959:    mov    r0, r19
                            	   960:    or     r0, CM_PASSWORD
                            	   961:    st     r0, (r18)
                            	   962:    b      not_full\@
                            	   963: 
                            	   964: use_slow_pll_full\@:
                            	   965:    add    r19, PLL_OFFSET_SLOW
                            	   966:    mov    r0, r19
                            	   967:    or     r0, CM_PASSWORD
                            	   968:    st     r0, (r18)
                            	   969:    b      not_full\@
                            	   970: drop_full_ERRORF\@:
                            	   971:    mov    r0, (1 << HD_MAI_CTL_RST_MAI) | (1 << HD_MAI_CTL_ERRORF) | (1 << HD_MAI_CTL_ERRORE) | (1 << HD_MAI_CTL_DLATE)
                            	   972:    st     r0, (r7)    #clear ERRORF
                            	   973:    mov    r0, (1 << HD_MAI_CTL_ENABLE) | (2 << HD_MAI_CTL_CHNUM) | (1 << HD_MAI_CTL_WHOLSMP) | (1 << HD_MAI_CTL_CHALIGN
                            	   974:    st     r0, (r7)
                            	   975:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	   976:    bset   r2, REPEAT_SAMPLE #as buffer flushed
                            	   977:    b      dont_drop\@
                            	   978: drop_full\@:
                            	   979:    bset   r2, DROP_SAMPLE
                            	   980: dont_drop\@:
                            	   981:    add    r23, 1
                            	   982:    bclr   r23, 15  #max 32767
                            	   983:    st     r23, SMI_DROP_REPEAT_COUNT(r20)
                            	   984: not_full\@:
                            	   985: 
                            	   986: .endm
