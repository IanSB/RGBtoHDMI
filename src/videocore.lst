                            	   774: .macro IEC958_STATUS
                            	   775: 
                            	   776:     #byte 0 = 0x04   - bits 0-7,   bit 2 set   // consumer, PCM, no copyright, no pre-emphasis
                            	   777:     #byte 1 = 0x00   - bits 8-15                // category (general mode)
                            	   778:     #byte 2 = 0x00   - bits 16-23              // source number, take no account of channel number
                            	   779:     #byte 3 = 0x02   - bits 24-31  bit 25 set    // sampling frequency uchFS = 2 = 48000
                            	   780:     #byte 4 = 0xDB   - bits 32-39  0b1011 | (13 << 4) bits 1101 1011   bits 32, 33, 35, 36, 38, 39      // 24 bit sampl
                            	   781: 
                            	   782:     cmp    r6, 0
                            	   783:     oreq   r1, IEC958_B_FRAME_PREAMBLE
                            	   784:     cmp r6, (IEC958_STATUS_BYTES * 8)
                            	   785:     bge    no_status_bytes\@
                            	   786:     cmp   r6, 2
                            	   787:     cmpne r6, 25
                            	   788:     bseteq r1, 30
                            	   789:     sub   r6, 32
                            	   790:     cmp   r6, (32 - 32)
                            	   791:     cmpne r6, (33 - 32)
                            	   792:     cmpne r6, (35 - 32)
                            	   793:     cmpne r6, (36 - 32)
                            	   794:     cmpne r6, (38 - 32)
                            	   795:     cmpne r6, (39 - 32)
                            	   796:     bseteq r1, 30
                            	   797:     add   r6, 32
                            	   798: no_status_bytes\@:
                            	   799:     mov    r8, 0
                            	   800:     btst   r1, 31  #test existing parity count
                            	   801:     movne  r8, 1
                            	   802:     bclr   r1, 31
                            	   803: 
                            	   804:     btst   r1, 0
                            	   805:     addne  r8, 1
                            	   806:     btst   r1, 1
                            	   807:     addne  r8, 1
                            	   808:     btst   r1, 2
                            	   809:     addne  r8, 1
                            	   810:     btst   r1, 3
                            	   811:     addne  r8, 1
                            	   812:     btst   r1, 28
                            	   813:     addne  r8, 1
                            	   814:     btst   r1, 29
                            	   815:     addne  r8, 1
                            	   816:     btst   r1, 30
                            	   817:     addne  r8, 1
                            	   818: 
                            	   819:     btst   r8, 0
                            	   820:     bsetne r1, 31   # set parity bit as count is odd
                            	   821: 
                            	   822: .endm
                            	   823: 
                            	   824: .macro WRITE
                            	   825:     st     r1, (r5)
                            	   826: #increment buffer pointer
                            	   827:     add    r5, 4
                            	   828:     cmp    r5, r14
                            	   829:     movge  r5, r13
                            	   830: .endm
