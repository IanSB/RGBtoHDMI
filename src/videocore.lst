                            	  1184: vpu1_interrupt:
00:00000858 0A00            	  1185:    rti
                            	  1186: 
                            	  1187: #start of audio capture
                            	  1188: vpu1:
                            	  1189: audio_capture:
00:0000085A 9203            	  1190:    push   r0-r18,lr
                            	  1191: 
                            	  1192:    #r0 = gpio value
                            	  1193:    #r1 = sample value
                            	  1194:    #r2 = flags reg
                            	  1195:    #r3 = counter
                            	  1196:    #r4 = gpio address
                            	  1197:    #r5 = sample pointer
                            	  1198:    #r6 = frame counter
                            	  1199:    #r7 = MAI_CTRL pointer
                            	  1200:    #r8 = parity count
                            	  1201:    #r9 = overrun/underrun check counter
                            	  1202:    #r10 = DMA0POINTER
                            	  1203:    #r11 = copy of first sample
                            	  1204:    #r12 = copy of second sample
                            	  1205:    #r13 = low end of dma buffer
                            	  1206:    #r14 = high end of dma buffer
                            	  1207:    #r15 = audio data pin
