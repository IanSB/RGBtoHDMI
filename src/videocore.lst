                            	    79: #.equ PLL_SET_HIGH_2, 27
                            	    80: #.equ PLL_SET_LOW_1, 28
                            	    81: #.equ PLL_SET_HIGH_1, 29
                            	    82: .equ DROP_SAMPLE, 30
                            	    83: .equ REPEAT_SAMPLE, 31
                            	    84: 
