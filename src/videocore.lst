                            	     3M     #byte 1 = 0x00   - bits 8-15                // category (general mode)
                            	     4M     #byte 2 = 0x00   - bits 16-23              // source number, take no account of channel number
                            	     5M     #byte 3 = 0x02   - bits 24-31  bit 25 set    // sampling frequency uchFS = 2 = 48000
                            	     6M     #byte 4 = 0xDB   - bits 32-39  0b1011 | (13 << 4) bits 1101 1011   bits 32, 33, 35, 36, 38, 39      // 24 bit sampl
