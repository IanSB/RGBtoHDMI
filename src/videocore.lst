                            	  1010: .macro CAPTURE_AUDIO
                            	  1011:    HI_LRCLK
                            	  1012:    LO_LRCLK
                            	  1013:    b  audio_main_loop\@
                            	  1014: bad_sync_LR_high1\@:
                            	  1015: #WRITE_LEFT_RIGHT  using causes PLL trouble
                            	  1016:    LO_LRCLK
                            	  1017:    WRITE_LEFT_RIGHT
                            	  1018:    b  increment_error\@
                            	  1019: 
                            	  1020: bad_sync_LR_low1\@:
                            	  1021: #WRITE_LEFT_RIGHT  using causes PLL trouble
                            	  1022:    HI_LRCLK
                            	  1023:    LO_LRCLK
                            	  1024:    WRITE_LEFT_RIGHT
                            	  1025:    b  increment_error\@
                            	  1026: 
                            	  1027: bad_sync_LR_low2\@:
                            	  1028:    WRITE_LEFT_RIGHT   #removing causes PLL trouble
                            	  1029:    HI_LRCLK
                            	  1030:    LO_LRCLK
                            	  1031:    WRITE_LEFT_RIGHT
                            	  1032:    b  increment_error\@
                            	  1033: 
                            	  1034: bad_sync_LR_high2\@:
                            	  1035:    WRITE_LEFT_RIGHT
                            	  1036:    LO_LRCLK
                            	  1037:    WRITE_LEFT_RIGHT
