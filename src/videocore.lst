                            	  1179: vpu1_interrupt:
00:00000858 0A00            	  1180:    rti
                            	  1181: 
                            	  1182: #start of audio capture
                            	  1183: vpu1:
                            	  1184: audio_capture:
00:0000085A 9203            	  1185:    push   r0-r18,lr
                            	  1186: 
                            	  1187:    #r0 = gpio value
                            	  1188:    #r1 = sample value
                            	  1189:    #r2 = flags reg
                            	  1190:    #r3 = counter
                            	  1191:    #r4 = gpio address
                            	  1192:    #r5 = sample pointer
                            	  1193:    #r6 = frame counter
                            	  1194:    #r7 = MAI_CTRL pointer
                            	  1195:    #r8 = parity count
                            	  1196:    #r9 = overrun/underrun check counter
                            	  1197:    #r10 = DMA0POINTER
                            	  1198:    #r11 = copy of first sample
                            	  1199:    #r12 = copy of second sample
                            	  1200:    #r13 = low end of dma buffer
                            	  1201:    #r14 = high end of dma buffer
                            	  1202:    #r15 = audio data pin
                            	  1203:    #r16 = audio LR pin
                            	  1204:    #r17 = temp save reg
                            	  1205:    #r18 = pointer to PLLD FRAC register
                            	  1206:    #r19 = original value of PLLD FRAC register
