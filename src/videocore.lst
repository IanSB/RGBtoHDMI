                            	   786: .macro IEC958_STATUS
                            	   787: 
                            	   788:     #byte 0 = 0x04   - bits 0-7,   bit 2 set   // consumer, PCM, no copyright, no pre-emphasis
                            	   789:     #byte 1 = 0x00   - bits 8-15                // category (general mode)
                            	   790:     #byte 2 = 0x00   - bits 16-23              // source number, take no account of channel number
                            	   791:     #byte 3 = 0x02   - bits 24-31  bit 25 set    // sampling frequency uchFS = 2 = 48000
                            	   792:     #byte 4 = 0xDB   - bits 32-39  0b1011 | (13 << 4) bits 1101 1011   bits 32, 33, 35, 36, 38, 39      // 24 bit sampl
                            	   793: 
                            	   794:     cmp    r6, 0
                            	   795:     oreq   r1, IEC958_B_FRAME_PREAMBLE
                            	   796:     cmp r6, (IEC958_STATUS_BYTES * 8)
                            	   797:     bge    no_status_bytes\@
                            	   798:     cmp   r6, 2
                            	   799:     cmpne r6, 25
                            	   800:     bseteq r1, 30
                            	   801:     sub   r6, 32
                            	   802:     cmp   r6, (32 - 32)
                            	   803:     cmpne r6, (33 - 32)
                            	   804:     cmpne r6, (35 - 32)
                            	   805:     cmpne r6, (36 - 32)
                            	   806:     cmpne r6, (38 - 32)
                            	   807:     cmpne r6, (39 - 32)
                            	   808:     bseteq r1, 30
                            	   809:     add   r6, 32
                            	   810: no_status_bytes\@:
                            	   811:     mov    r8, 0
                            	   812:     btst   r1, 31  #test existing parity count
                            	   813:     movne  r8, 1
                            	   814:     bclr   r1, 31
                            	   815: 
                            	   816:     btst   r1, 0
                            	   817:     addne  r8, 1
                            	   818:     btst   r1, 1
                            	   819:     addne  r8, 1
                            	   820:     btst   r1, 2
                            	   821:     addne  r8, 1
                            	   822:     btst   r1, 3
                            	   823:     addne  r8, 1
                            	   824:     btst   r1, 28
                            	   825:     addne  r8, 1
                            	   826:     btst   r1, 29
                            	   827:     addne  r8, 1
                            	   828:     btst   r1, 30
                            	   829:     addne  r8, 1
                            	   830: 
                            	   831:     btst   r8, 0
                            	   832:     bsetne r1, 31   # set parity bit count is odd
                            	   833: 
                            	   834: .endm
                            	   835: 
                            	   836: .macro WRITE
                            	   837:     st     r1, (r5)
                            	   838: #increment buffer pointer
                            	   839:     add    r5, 4
                            	   840:     cmp    r5, r14
                            	   841:     movge  r5, r13
                            	   842: .endm
