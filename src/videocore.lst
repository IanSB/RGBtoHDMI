                            	   826: .macro CHECK_UNDERRUN
                            	   827:    # check for underrun
                            	   828:    cmp    r9,0x10
                            	   829:    bne    not_empty\@             #only check once per frame
                            	   830:    btst   r2, REPEAT_SAMPLE
                            	   831:    bne    not_empty\@          #repeat pending
                            	   832: 
                            	   833:    btst   r21, SMI_CTRL_BIT_DMA
                            	   834:    beq  not_dma_underrun\@
                            	   835: 
                            	   836:    ld     r0, (r10) #get dma pointer
                            	   837:    sub    r3, r14, r13  #buffer size
                            	   838:    cmp    r5, r0
                            	   839:    subge  r1, r5, r0
                            	   840:    bge    got_offset_under\@
                            	   841:    sub    r1, r0, r5
                            	   842:    sub    r1, r3, r1
                            	   843: got_offset_under\@:
                            	   844:    lsr    r3, 1
                            	   845:    sub    r1, r3
                            	   846:    st     r1, SMI_DMA_OFFSET(r20)
                            	   847:    rsb    r1, 0
                            	   848:    cmp    r1, MAX_DMA_DRIFT_ERROR
                            	   849:    bgt    repeat_empty\@
                            	   850:    cmp    r1, MAX_DMA_DRIFT
                            	   851:    bgt    empty\@
                            	   852:    b      not_empty\@
                            	   853: 
                            	   854: not_dma_underrun\@:
                            	   855:    ld     r0, (r7)  #read MAI CTL
                            	   856:    btst   r0, HD_MAI_CTL_ERRORE
                            	   857:    bne    repeat_empty\@
                            	   858:    btst   r0, HD_MAI_CTL_EMPTY
                            	   859:    beq    not_empty\@
                            	   860: empty\@:
                            	   861:    btst   r21, SMI_CTRL_BIT_PLL_1
                            	   862:    beq    repeat_empty\@
                            	   863:    btst   r21, SMI_CTRL_BIT_PLL_0
                            	   864:    beq    use_slow_pll_empty\@
                            	   865: 
                            	   866: #   mov    r0, r19
                            	   867: #   sub    r0, PLL_OFFSET_FAST
                            	   868:    sub    r19, PLL_OFFSET_FAST
                            	   869:    mov    r0, r19
                            	   870:    or     r0, CM_PASSWORD
                            	   871:    st     r0, (r18)
                            	   872:    b      not_empty\@
                            	   873: 
                            	   874: use_slow_pll_empty\@:
                            	   875:    sub    r19, PLL_OFFSET_SLOW
                            	   876:    mov    r0, r19
                            	   877:    or     r0, CM_PASSWORD
                            	   878:    st     r0, (r18)
                            	   879:    b      not_empty\@
                            	   880: 
                            	   881: repeat_empty\@:
                            	   882:    bset   r2, REPEAT_SAMPLE
                            	   883:    add    r23, 0x10000
                            	   884:    bclr   r23, 31   #max 32767
                            	   885:    st     r23, SMI_DROP_REPEAT_COUNT(r20)
                            	   886: not_empty\@:
                            	   887: 
                            	   888: .endm
