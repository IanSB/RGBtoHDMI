                            	   996: .macro WRITE_LEFT_RIGHT
                            	   997:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	   998:    btst   r2, REPEAT_22Khz
                            	   999:    beq    no_repeat_sample\@
                            	  1000:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	  1001: no_repeat_sample\@:
