                            	   923:    mov    r0, (1 << HD_MAI_CTL_ENABLE) | (2 << HD_MAI_CTL_CHNUM) | (1 << HD_MAI_CTL_WHOLSMP) | (1 << HD_MAI_CTL_CHALIGN
                            	   924:    st     r0, (r7)
