                            	  1005: .macro CAPTURE_AUDIO
                            	  1006:    HI_LRCLK
                            	  1007:    LO_LRCLK
                            	  1008:    b  audio_main_loop\@
                            	  1009: bad_sync_LR_high1\@:
                            	  1010: #WRITE_LEFT_RIGHT  using causes PLL trouble
                            	  1011:    LO_LRCLK
                            	  1012:    WRITE_LEFT_RIGHT
                            	  1013:    b  increment_error\@
                            	  1014: 
                            	  1015: bad_sync_LR_low1\@:
                            	  1016: #WRITE_LEFT_RIGHT  using causes PLL trouble
                            	  1017:    HI_LRCLK
                            	  1018:    LO_LRCLK
                            	  1019:    WRITE_LEFT_RIGHT
                            	  1020:    b  increment_error\@
                            	  1021: 
                            	  1022: bad_sync_LR_low2\@:
                            	  1023:    WRITE_LEFT_RIGHT   #removing causes PLL trouble
                            	  1024:    HI_LRCLK
                            	  1025:    LO_LRCLK
                            	  1026:    WRITE_LEFT_RIGHT
                            	  1027:    b  increment_error\@
                            	  1028: 
                            	  1029: bad_sync_LR_high2\@:
                            	  1030:    WRITE_LEFT_RIGHT
                            	  1031:    LO_LRCLK
                            	  1032:    WRITE_LEFT_RIGHT
                            	  1033: 
                            	  1034: increment_error\@:
                            	  1035:    add    r22, 1
                            	  1036:    bset   r2, LOG_FRAME_ERROR
                            	  1037: audio_main_loop\@:
                            	  1038: 
                            	  1039:    #capture first sample
                            	  1040:    #LR clock has just gone high
                            	  1041:    btst   r21, SMI_CTRL_BIT_RUN
                            	  1042:    beq    abort_audio            #destination not in macro
                            	  1043: 
                            	  1044:    mov    r3, 24
                            	  1045:    mov    r1, 0
                            	  1046:    mov    r8, 0 #parity count
                            	  1047: firstloop\@:
                            	  1048:    lsl    r1, 1
                            	  1049:    WAIT_FOR_DATA_BIT
                            	  1050:    orne   r1, 1
                            	  1051:    sub    r3, 1
                            	  1052:    cmp    r3, 0
                            	  1053:    bne    firstloop\@
                            	  1054:    lsl    r1, 4
                            	  1055:    btst   r8, 0
                            	  1056:    bsetne r1, 31   # temp set parity bit if count is odd
                            	  1057: 
                            	  1058:    mov    r17, r1   #temp save
                            	  1059: 
                            	  1060:    WAIT_FOR_DATA_BIT
                            	  1061: 
                            	  1062:    CHECK_OVERRUN
                            	  1063: 
                            	  1064:    WAIT_FOR_DATA_BIT
                            	  1065: 
                            	  1066:    cmp    r9, BUFFER_CHECK_COUNT >> 1
                            	  1067:    bne    skip_update\@
                            	  1068:    ld     r21, SMI_CTRL(r20)      #update the control register
                            	  1069: skip_update\@:
                            	  1070: 
                            	  1071:    mov    r3, 4
                            	  1072: firstremain\@:
                            	  1073:    WAIT_FOR_DATA_BIT
                            	  1074:    sub    r3, 1
                            	  1075:    cmp    r3, 0
                            	  1076:    bne    firstremain\@
                            	  1077: 
                            	  1078:    cmp    r9, (BUFFER_CHECK_COUNT >> 1) + 0x10
                            	  1079:    bne    skip_log\@
                            	  1080:    btst   r2, LOG_FRAME_ERROR
                            	  1081:    beq    skip_log\@
                            	  1082:    st     r22, SMI_ERROR_COUNT(r20)
                            	  1083:    bclr   r2, LOG_FRAME_ERROR
                            	  1084: skip_log\@:
                            	  1085: 
                            	  1086:    WAIT_FOR_LR_BIT
                            	  1087:    bne    bad_sync_LR_high1\@
                            	  1088:    WAIT_HI_TWOGPIO_ONLY
                            	  1089: 
                            	  1090:    WAIT_FOR_LR_BIT
                            	  1091:    beq    bad_sync_LR_low1\@
                            	  1092:    mov    r1, r17
                            	  1093:    mov    r11, r1   #save in case of repeat
                            	  1094:    IEC958_STATUS
                            	  1095:    mov    r17, r1
                            	  1096:    WAIT_HI_TWOGPIO_ONLY
                            	  1097: 
                            	  1098:    #capture second sample
                            	  1099:    #LR clock has just gone low
                            	  1100:    mov    r3, 24
                            	  1101:    mov    r1, 0
                            	  1102:    mov    r8, 0 #parity count
                            	  1103: secondloop\@:
                            	  1104:    lsl    r1, 1
                            	  1105:    WAIT_FOR_DATA_BIT
                            	  1106:    orne   r1, 1
                            	  1107:    sub    r3, 1
                            	  1108:    cmp    r3, 0
                            	  1109:    bne    secondloop\@
                            	  1110:    lsl    r1, 4
                            	  1111:    btst   r8, 0
                            	  1112:    bsetne r1, 31   # temp set parity bit if count is odd
                            	  1113:    mov    r24, r1   #temp save
                            	  1114: 
                            	  1115:    WAIT_FOR_DATA_BIT
                            	  1116: 
                            	  1117:    CHECK_UNDERRUN
                            	  1118: 
                            	  1119:    WAIT_FOR_DATA_BIT
                            	  1120: 
                            	  1121:    btst   r2, REPEAT_SAMPLE
                            	  1122:    beq    no_repeat_main\@
                            	  1123:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	  1124:    bclr   r2, REPEAT_SAMPLE
                            	  1125: no_repeat_main\@:
                            	  1126: 
                            	  1127:    mov    r3, 4
                            	  1128: secondremain\@:
                            	  1129:    WAIT_FOR_DATA_BIT
                            	  1130:    sub    r3, 1
                            	  1131:    cmp    r3, 0
                            	  1132:    bne    secondremain\@
                            	  1133: 
                            	  1134:    mov    r1, r24
                            	  1135:    IEC958_STATUS
                            	  1136:    mov    r0, r24
                            	  1137:    mov    r24, r1   #temp save
                            	  1138:    mov    r1, r0
                            	  1139: 
                            	  1140:    WAIT_FOR_LR_BIT
                            	  1141:    beq    bad_sync_LR_low2\@
                            	  1142:    WAIT_HI_TWOGPIO_ONLY
                            	  1143: 
                            	  1144:    WAIT_FOR_LR_BIT
                            	  1145:    bne    bad_sync_LR_high2\@
                            	  1146:    mov    r12, r1   #save in case of repeat
                            	  1147:    WAIT_HI_TWOGPIO_ONLY
                            	  1148: 
                            	  1149:    btst   r2, DROP_SAMPLE
                            	  1150:    bclrne r2, DROP_SAMPLE
                            	  1151:    bne    drop_main\@
                            	  1152: 
                            	  1153:    btst   r21, SMI_CTRL_BIT_MONO_RIGHT
                            	  1154:    movne  r1, r24
                            	  1155:    moveq  r1, r17
                            	  1156:    WRITE
                            	  1157:    btst   r21, SMI_CTRL_BIT_MONO_LEFT
                            	  1158:    movne  r1, r17
                            	  1159:    moveq  r1, r24
                            	  1160:    WRITE
                            	  1161:    add    r6, 1
                            	  1162:    cmp    r6, IEC958_FRAMES_PER_BLOCK
                            	  1163:    movge  r6, 0
                            	  1164: drop_main\@:
                            	  1165:    btst   r2, REPEAT_22Khz
                            	  1166:    beq    no_repeat_sample_main\@
                            	  1167:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	  1168: no_repeat_sample_main\@:
                            	  1169: 
                            	  1170:    add    r9, 1
                            	  1171:    cmp    r9, BUFFER_CHECK_COUNT
                            	  1172:    movge  r9, 0
                            	  1173: 
                            	  1174:    b      audio_main_loop\@
                            	  1175: 
                            	  1176: 
                            	  1177: .endm
