                            	   966: .macro CAPTURE_AUDIO
                            	   967:    HI_LRCLK
                            	   968:    LO_LRCLK
                            	   969:    b  audio_main_loop\@
                            	   970: bad_sync_LR_high1\@:
                            	   971: #WRITE_LEFT_RIGHT  using causes PLL trouble
                            	   972:    LO_LRCLK
                            	   973:    WRITE_LEFT_RIGHT
                            	   974:    b  increment_error\@
                            	   975: 
                            	   976: bad_sync_LR_low1\@:
                            	   977: #WRITE_LEFT_RIGHT  using causes PLL trouble
                            	   978:    HI_LRCLK
                            	   979:    LO_LRCLK
                            	   980:    WRITE_LEFT_RIGHT
