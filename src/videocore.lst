                            	   640: #*****************************************************************************************
                            	   641: #macros for audio capture
                            	   642: .macro DELAY_NOP
                            	   643:    nop
                            	   644:    nop
                            	   645:    nop
                            	   646:    nop
                            	   647: 
                            	   648: .endm
                            	   649: 
                            	   650: 
                            	   651: .macro WAIT_EDGE_FOR_DATA_BIT
                            	   652: waitBCH\@:
                            	   653:    ld     r0, (r4)
                            	   654:    DELAY_NOP
                            	   655:    eor    r0, r2
                            	   656:    btst   r0, CLOCK_BIT
                            	   657:    beq    waitBCH\@
                            	   658:    ld     r0, (r4)          #second read for reliability
                            	   659:    bchg   r2, CLOCK_BIT     #edge detect if using 3 gpios otherwise high detect
                            	   660:    btst   r0, r15 # DATABIT
                            	   661:    addne  r8, 1  #parity count
                            	   662: .endm
                            	   663: 
                            	   664: .macro WAIT_EDGE_FOR_LR_BIT
                            	   665: waitBCH\@:
                            	   666:    ld     r0, (r4)
                            	   667:    DELAY_NOP
                            	   668:    eor    r0, r2
                            	   669:    btst   r0, CLOCK_BIT
                            	   670:    beq    waitBCH\@
                            	   671:    ld     r0, (r4)          #second read for reliability
                            	   672:    bchg   r2, CLOCK_BIT     #edge detect if using 3 gpios otherwise high detect
                            	   673:    btst   r0, r16 # LRBIT
                            	   674: .endm
                            	   675: 
                            	   676: .macro HI_BITCLK_FOR_DATA_BIT
                            	   677: waitBCH\@:
                            	   678:    ld     r0, (r4)
                            	   679: #   DELAY_NOP
                            	   680:    btst   r0, CLOCK_BIT
                            	   681: .if INVERTED_CLOCK == 1
                            	   682:    bne    waitBCH\@
                            	   683: .else
                            	   684:    beq    waitBCH\@
                            	   685: .endif
                            	   686: #   DELAY_NOP
                            	   687:    ld     r0, (r4)
                            	   688:    btst   r0, r15 # DATABIT
                            	   689:    addne  r8, 1  #parity count
                            	   690: .endm
                            	   691: 
                            	   692: .macro LO_BITCLK_FOR_LR_BIT
                            	   693: waitBCL\@:
                            	   694:    ld     r0, (r4)
                            	   695: #   DELAY_NOP
                            	   696:    btst   r0, CLOCK_BIT
                            	   697: .if INVERTED_CLOCK == 1
                            	   698:    beq    waitBCL\@
                            	   699: .else
                            	   700:    bne    waitBCL\@
                            	   701: .endif
                            	   702: #   DELAY_NOP
                            	   703:    ld     r0, (r4)   #second read for delay to allow LR to stabilise in two gpio mode
                            	   704:    btst   r0, r16 # LRBIT
                            	   705: .endm
                            	   706: 
                            	   707: .macro HI_BITCLK
                            	   708: waitBCHO\@:
                            	   709:    ld     r0, (r4)
                            	   710: #   DELAY_NOP
                            	   711:    btst   r0, CLOCK_BIT
                            	   712: .if INVERTED_CLOCK == 1
                            	   713:    bne    waitBCHO\@
                            	   714: .else
                            	   715:    beq    waitBCHO\@
                            	   716: .endif
                            	   717: .endm
                            	   718: 
                            	   719: .macro LO_BITCLK
                            	   720: waitBCLO\@:
                            	   721:    ld     r0, (r4)
                            	   722: #   DELAY_NOP
                            	   723:    btst   r0, CLOCK_BIT
                            	   724: .if INVERTED_CLOCK == 1
                            	   725:    beq    waitBCLO\@
                            	   726: .else
                            	   727:    bne    waitBCLO\@
                            	   728: .endif
                            	   729: .endm
                            	   730: 
                            	   731: .macro WAIT_FOR_DATA_BIT
                            	   732: .if TWOGPIO == 1
                            	   733:    LO_BITCLK
                            	   734:    HI_BITCLK_FOR_DATA_BIT
                            	   735: .else
                            	   736:    WAIT_EDGE_FOR_DATA_BIT
                            	   737: .endif
                            	   738: .endm
                            	   739: 
                            	   740: .macro WAIT_FOR_LR_BIT
                            	   741: .if TWOGPIO == 1
                            	   742:    LO_BITCLK_FOR_LR_BIT
                            	   743: .else
                            	   744:    WAIT_EDGE_FOR_LR_BIT
                            	   745: .endif
                            	   746: .endm
                            	   747: 
                            	   748: .macro WAIT_HI_TWOGPIO_ONLY
                            	   749: .if TWOGPIO == 1
                            	   750:    HI_BITCLK
                            	   751: .endif
                            	   752: .endm
                            	   753: 
                            	   754: .macro LO_LRCLK
                            	   755: .if TWOGPIO == 1
                            	   756: waitLRCL2\@:
                            	   757:    HI_BITCLK
                            	   758:    LO_BITCLK_FOR_LR_BIT
                            	   759:    bne    waitLRCL2\@
                            	   760:    HI_BITCLK
                            	   761: .else
                            	   762: waitLRCL\@:
                            	   763:    WAIT_EDGE_FOR_LR_BIT
                            	   764:    bne    waitLRCL\@
                            	   765: .endif
                            	   766: .endm
                            	   767: 
                            	   768: 
                            	   769: .macro HI_LRCLK
                            	   770: .if TWOGPIO == 1
                            	   771: waitLRCH2\@:
                            	   772:    HI_BITCLK
                            	   773:    LO_BITCLK_FOR_LR_BIT
                            	   774:    beq    waitLRCH2\@
                            	   775:    HI_BITCLK
                            	   776: .else
                            	   777: waitLRCH\@:
                            	   778:    WAIT_EDGE_FOR_LR_BIT
                            	   779:    beq    waitLRCH\@
                            	   780: .endif
                            	   781: .endm
                            	   782: 
                            	   783: 
