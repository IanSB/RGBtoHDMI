                            	   756: .macro IEC958_STATUS
                            	   757: 
                            	   758:     #byte 0 = 0x04   - bits 0-7,   bit 2 set   // consumer, PCM, no copyright, no pre-emphasis
                            	   759:     #byte 1 = 0x00   - bits 8-15                // category (general mode)
                            	   760:     #byte 2 = 0x00   - bits 16-23              // source number, take no account of channel number
                            	   761:     #byte 3 = 0x02   - bits 24-31  bit 25 set    // sampling frequency uchFS = 2 = 48000
                            	   762:     #byte 4 = 0xDB   - bits 32-39  0b1011 | (13 << 4) bits 1101 1011   bits 32, 33, 35, 36, 38, 39      // 24 bit sampl
                            	   763: 
                            	   764:     cmp    r6, 0
                            	   765:     oreq   r1, IEC958_B_FRAME_PREAMBLE
                            	   766:     cmp r6, (IEC958_STATUS_BYTES * 8)
                            	   767:     bge    no_status_bytes\@
                            	   768:     cmp   r6, 2
                            	   769:     cmpne r6, 25
                            	   770:     bseteq r1, 30
                            	   771:     sub   r6, 32
                            	   772:     cmp   r6, (32 - 32)
                            	   773:     cmpne r6, (33 - 32)
                            	   774:     cmpne r6, (35 - 32)
                            	   775:     cmpne r6, (36 - 32)
                            	   776:     cmpne r6, (38 - 32)
                            	   777:     cmpne r6, (39 - 32)
                            	   778:     bseteq r1, 30
                            	   779:     add   r6, 32
                            	   780: no_status_bytes\@:
                            	   781:     mov    r8, 0
                            	   782:     btst   r1, 31  #test existing parity count
                            	   783:     movne  r8, 1
                            	   784:     bclr   r1, 31
                            	   785: 
                            	   786:     btst   r1, 0
                            	   787:     addne  r8, 1
                            	   788:     btst   r1, 1
                            	   789:     addne  r8, 1
                            	   790:     btst   r1, 2
                            	   791:     addne  r8, 1
                            	   792:     btst   r1, 3
                            	   793:     addne  r8, 1
                            	   794:     btst   r1, 28
                            	   795:     addne  r8, 1
                            	   796:     btst   r1, 29
                            	   797:     addne  r8, 1
                            	   798:     btst   r1, 30
                            	   799:     addne  r8, 1
                            	   800: 
                            	   801:     btst   r8, 0
                            	   802:     bsetne r1, 31   # set parity bit count is odd
                            	   803: 
                            	   804: .endm
                            	   805: 
                            	   806: .macro WRITE
                            	   807:     st     r1, (r5)
                            	   808: #increment buffer pointer
                            	   809:     add    r5, 4
                            	   810:     cmp    r5, r14
                            	   811:     movge  r5, r13
                            	   812: .endm
