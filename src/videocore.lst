                            	   865: .macro CHECK_UNDERRUN
                            	   866:    # check for underrun
                            	   867:    cmp    r9,0x10
                            	   868:    bne    not_empty\@             #only check once per frame
                            	   869:    btst   r2, REPEAT_SAMPLE
                            	   870:    bne    not_empty\@          #repeat pending
                            	   871: 
                            	   872:    btst   r21, SMI_CTRL_BIT_DMA
                            	   873:    beq  not_dma_underrun\@
                            	   874: 
                            	   875:    ld     r0, (r10) #get dma pointer
                            	   876:    sub    r3, r14, r13  #buffer size
                            	   877:    cmp    r5, r0
                            	   878:    subge  r1, r5, r0
                            	   879:    bge    got_offset_under\@
                            	   880:    sub    r1, r0, r5
                            	   881:    sub    r1, r3, r1
                            	   882: got_offset_under\@:
                            	   883:    lsr    r3, 1
                            	   884:    sub    r1, r3
                            	   885:    st     r1, SMI_DMA_OFFSET(r20)
                            	   886:    rsb    r1, 0
                            	   887:    cmp    r1, MAX_DMA_DRIFT_ERROR
                            	   888:    bgt    repeat_empty\@
                            	   889:    cmp    r1, MAX_DMA_DRIFT
                            	   890:    bgt    empty\@
                            	   891:    b      not_empty\@
                            	   892: 
                            	   893: not_dma_underrun\@:
                            	   894:    ld     r0, (r7)  #read MAI CTL
                            	   895:    btst   r0, HD_MAI_CTL_ERRORE
                            	   896:    bne    repeat_empty_ERRORE\@
                            	   897:    btst   r0, HD_MAI_CTL_EMPTY
                            	   898:    beq    not_empty\@
                            	   899: empty\@:
                            	   900:    btst   r21, SMI_CTRL_BIT_PLL_1
                            	   901:    beq    repeat_empty\@
                            	   902:    btst   r21, SMI_CTRL_BIT_PLL_0
                            	   903:    beq    use_slow_pll_empty\@
                            	   904: 
                            	   905: #   mov    r0, r19
