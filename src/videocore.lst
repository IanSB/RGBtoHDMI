                            	   948:    mov    r0, r19
                            	   949:    or     r0, CM_PASSWORD
                            	   950:    st     r0, (r18)
                            	   951:    b      not_empty\@
                            	   952: 
                            	   953: repeat_empty_ERRORE\@:
                            	   954:    mov    r0, (1 << HD_MAI_CTL_RST_MAI) | (1 << HD_MAI_CTL_ERRORF) | (1 << HD_MAI_CTL_ERRORE) | (1 << HD_MAI_CTL_DLATE)
                            	   955:    st     r0, (r7)    #clear ERRORE
                            	   956:    mov    r0, (1 << HD_MAI_CTL_ENABLE) | (2 << HD_MAI_CTL_CHNUM) | (1 << HD_MAI_CTL_WHOLSMP) | (1 << HD_MAI_CTL_CHALIGN
                            	   957:    st     r0, (r7)
