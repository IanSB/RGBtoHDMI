                            	   640: #*****************************************************************************************
                            	   641: #macros for audio capture
                            	   642: .macro DELAY_NOP
                            	   643:    nop
                            	   644:    nop
                            	   645:    nop
                            	   646:    nop
                            	   647:    nop
                            	   648:    nop
                            	   649: 
                            	   650: .endm
                            	   651: 
                            	   652: .macro DELAY_NOP2
                            	   653:    nop
                            	   654:    nop
                            	   655: 
                            	   656: .endm
                            	   657: 
                            	   658: .macro WAIT_EDGE_FOR_DATA_BIT
                            	   659: waitBCH\@:
                            	   660:    ld     r0, (r4)
                            	   661:    DELAY_NOP
                            	   662:    eor    r0, r2
                            	   663:    btst   r0, CLOCK_BIT
                            	   664:    beq    waitBCH\@
                            	   665:    ld     r0, (r4)          #second read for reliability
                            	   666:    bchg   r2, CLOCK_BIT     #edge detect if using 3 gpios otherwise high detect
                            	   667:    btst   r0, r15 # DATABIT
                            	   668:    addne  r8, 1  #parity count
                            	   669: .endm
                            	   670: 
                            	   671: .macro WAIT_EDGE_FOR_LR_BIT
                            	   672: waitBCH\@:
                            	   673:    ld     r0, (r4)
                            	   674:    DELAY_NOP
                            	   675:    eor    r0, r2
                            	   676:    btst   r0, CLOCK_BIT
                            	   677:    beq    waitBCH\@
                            	   678:    ld     r0, (r4)          #second read for reliability
                            	   679:    bchg   r2, CLOCK_BIT     #edge detect if using 3 gpios otherwise high detect
                            	   680:    btst   r0, r16 # LRBIT
                            	   681: .endm
                            	   682: 
                            	   683: .macro HI_BITCLK_FOR_DATA_BIT
                            	   684: waitBCH\@:
                            	   685:    ld     r0, (r4)
                            	   686: #   DELAY_NOP2
                            	   687:    btst   r0, CLOCK_BIT
                            	   688: .if INVERTED_CLOCK == 1
                            	   689:    bne    waitBCH\@
                            	   690: .else
                            	   691:    beq    waitBCH\@
                            	   692: .endif
                            	   693:    ld     r0, (r4)
                            	   694:    btst   r0, r15 # DATABIT
                            	   695:    addne  r8, 1  #parity count
                            	   696: .endm
                            	   697: 
                            	   698: .macro LO_BITCLK_FOR_LR_BIT
                            	   699: waitBCL\@:
                            	   700:    ld     r0, (r4)
                            	   701: #   DELAY_NOP2
                            	   702:    btst   r0, CLOCK_BIT
                            	   703: .if INVERTED_CLOCK == 1
                            	   704:    beq    waitBCL\@
                            	   705: .else
                            	   706:    bne    waitBCL\@
                            	   707: .endif
                            	   708:    ld     r0, (r4)   #second read for delay to allow LR to stabilise in two gpio mode
                            	   709:    btst   r0, r16 # LRBIT
                            	   710: .endm
                            	   711: 
                            	   712: .macro HI_BITCLK
                            	   713: waitBCHO\@:
                            	   714:    ld     r0, (r4)
                            	   715: #   DELAY_NOP2
                            	   716:    btst   r0, CLOCK_BIT
                            	   717: .if INVERTED_CLOCK == 1
                            	   718:    bne    waitBCHO\@
                            	   719: .else
                            	   720:    beq    waitBCHO\@
                            	   721: .endif
                            	   722: .endm
                            	   723: 
                            	   724: .macro LO_BITCLK
                            	   725: waitBCLO\@:
                            	   726:    ld     r0, (r4)
                            	   727: #   DELAY_NOP2
                            	   728:    btst   r0, CLOCK_BIT
                            	   729: .if INVERTED_CLOCK == 1
                            	   730:    beq    waitBCLO\@
                            	   731: .else
                            	   732:    bne    waitBCLO\@
                            	   733: .endif
                            	   734: .endm
                            	   735: 
                            	   736: .macro WAIT_FOR_DATA_BIT
                            	   737: .if TWOGPIO == 1
                            	   738:    LO_BITCLK
                            	   739:    HI_BITCLK_FOR_DATA_BIT
                            	   740: .else
                            	   741:    WAIT_EDGE_FOR_DATA_BIT
                            	   742: .endif
                            	   743: .endm
                            	   744: 
                            	   745: .macro WAIT_FOR_LR_BIT
                            	   746: .if TWOGPIO == 1
                            	   747:    LO_BITCLK_FOR_LR_BIT
                            	   748: .else
                            	   749:    WAIT_EDGE_FOR_LR_BIT
                            	   750: .endif
                            	   751: .endm
                            	   752: 
                            	   753: .macro WAIT_HI_TWOGPIO_ONLY
                            	   754: .if TWOGPIO == 1
                            	   755:    HI_BITCLK
                            	   756: .endif
                            	   757: .endm
                            	   758: 
                            	   759: .macro LO_LRCLK
                            	   760: .if TWOGPIO == 1
                            	   761: waitLRCL2\@:
                            	   762:    HI_BITCLK
                            	   763:    LO_BITCLK_FOR_LR_BIT
                            	   764:    bne    waitLRCL2\@
                            	   765:    HI_BITCLK
                            	   766: .else
                            	   767: waitLRCL\@:
                            	   768:    WAIT_EDGE_FOR_LR_BIT
                            	   769:    bne    waitLRCL\@
                            	   770: .endif
                            	   771: .endm
                            	   772: 
                            	   773: 
                            	   774: .macro HI_LRCLK
                            	   775: .if TWOGPIO == 1
                            	   776: waitLRCH2\@:
                            	   777:    HI_BITCLK
                            	   778:    LO_BITCLK_FOR_LR_BIT
                            	   779:    beq    waitLRCH2\@
                            	   780:    HI_BITCLK
                            	   781: .else
                            	   782: waitLRCH\@:
                            	   783:    WAIT_EDGE_FOR_LR_BIT
                            	   784:    beq    waitLRCH\@
                            	   785: .endif
                            	   786: .endm
                            	   787: 
                            	   788: 
