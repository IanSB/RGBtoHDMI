                            	  1057:    mov    r3, 24
                            	  1058:    mov    r1, 0
                            	  1059:    mov    r8, 0 #parity count
                            	  1060: secondloop\@:
                            	  1061:    lsl    r1, 1
                            	  1062:    WAIT_FOR_DATA_BIT
                            	  1063:    orne   r1, 1
