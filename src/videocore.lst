                            	  1201: vpu1_interrupt:
00:00000858 0A00            	  1202:    rti
                            	  1203: 
                            	  1204: #start of audio capture
                            	  1205: vpu1:
                            	  1206: audio_capture:
00:0000085A 9203            	  1207:    push   r0-r18,lr
                            	  1208: 
                            	  1209:    #r0 = gpio value
                            	  1210:    #r1 = sample value
                            	  1211:    #r2 = flags reg
                            	  1212:    #r3 = counter
                            	  1213:    #r4 = gpio address
