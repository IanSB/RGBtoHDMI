                            	   640: #*****************************************************************************************
                            	   641: #macros for audio capture
                            	   642: .macro DELAY_NOP
                            	   643:    nop
                            	   644:    nop
                            	   645:    nop
                            	   646:    nop
                            	   647: 
                            	   648: .endm
                            	   649: 
                            	   650: .macro DELAY_NOP2
                            	   651:    nop
                            	   652:    nop
                            	   653: 
                            	   654: .endm
                            	   655: 
                            	   656: .macro WAIT_EDGE_FOR_DATA_BIT
                            	   657: waitBCH\@:
                            	   658:    ld     r0, (r4)
                            	   659:    DELAY_NOP
                            	   660:    eor    r0, r2
                            	   661:    btst   r0, CLOCK_BIT
                            	   662:    beq    waitBCH\@
                            	   663:    ld     r0, (r4)          #second read for reliability
                            	   664:    bchg   r2, CLOCK_BIT     #edge detect if using 3 gpios otherwise high detect
                            	   665:    btst   r0, r15 # DATABIT
                            	   666:    addne  r8, 1  #parity count
                            	   667: .endm
                            	   668: 
                            	   669: .macro WAIT_EDGE_FOR_LR_BIT
                            	   670: waitBCH\@:
                            	   671:    ld     r0, (r4)
                            	   672:    DELAY_NOP
                            	   673:    eor    r0, r2
                            	   674:    btst   r0, CLOCK_BIT
                            	   675:    beq    waitBCH\@
                            	   676:    ld     r0, (r4)          #second read for reliability
                            	   677:    bchg   r2, CLOCK_BIT     #edge detect if using 3 gpios otherwise high detect
                            	   678:    btst   r0, r16 # LRBIT
                            	   679: .endm
                            	   680: 
                            	   681: .macro HI_BITCLK_FOR_DATA_BIT
                            	   682: waitBCH\@:
                            	   683:    ld     r0, (r4)
                            	   684: #   DELAY_NOP2
                            	   685:    btst   r0, CLOCK_BIT
                            	   686: .if INVERTED_CLOCK == 1
                            	   687:    bne    waitBCH\@
                            	   688: .else
                            	   689:    beq    waitBCH\@
                            	   690: .endif
                            	   691:    ld     r0, (r4)
                            	   692:    btst   r0, r15 # DATABIT
                            	   693:    addne  r8, 1  #parity count
                            	   694: .endm
                            	   695: 
                            	   696: .macro LO_BITCLK_FOR_LR_BIT
                            	   697: waitBCL\@:
                            	   698:    ld     r0, (r4)
                            	   699: #   DELAY_NOP2
                            	   700:    btst   r0, CLOCK_BIT
                            	   701: .if INVERTED_CLOCK == 1
                            	   702:    beq    waitBCL\@
                            	   703: .else
                            	   704:    bne    waitBCL\@
                            	   705: .endif
                            	   706:    ld     r0, (r4)   #second read for delay to allow LR to stabilise in two gpio mode
                            	   707:    btst   r0, r16 # LRBIT
                            	   708: .endm
                            	   709: 
                            	   710: .macro HI_BITCLK
                            	   711: waitBCHO\@:
                            	   712:    ld     r0, (r4)
                            	   713: #   DELAY_NOP2
                            	   714:    btst   r0, CLOCK_BIT
                            	   715: .if INVERTED_CLOCK == 1
                            	   716:    bne    waitBCHO\@
                            	   717: .else
                            	   718:    beq    waitBCHO\@
                            	   719: .endif
                            	   720: .endm
                            	   721: 
                            	   722: .macro LO_BITCLK
                            	   723: waitBCLO\@:
                            	   724:    ld     r0, (r4)
                            	   725: #   DELAY_NOP2
                            	   726:    btst   r0, CLOCK_BIT
                            	   727: .if INVERTED_CLOCK == 1
                            	   728:    beq    waitBCLO\@
                            	   729: .else
                            	   730:    bne    waitBCLO\@
                            	   731: .endif
                            	   732: .endm
                            	   733: 
                            	   734: .macro WAIT_FOR_DATA_BIT
                            	   735: .if TWOGPIO == 1
                            	   736:    LO_BITCLK
                            	   737:    HI_BITCLK_FOR_DATA_BIT
                            	   738: .else
                            	   739:    WAIT_EDGE_FOR_DATA_BIT
                            	   740: .endif
                            	   741: .endm
                            	   742: 
                            	   743: .macro WAIT_FOR_LR_BIT
                            	   744: .if TWOGPIO == 1
                            	   745:    LO_BITCLK_FOR_LR_BIT
                            	   746: .else
                            	   747:    WAIT_EDGE_FOR_LR_BIT
                            	   748: .endif
                            	   749: .endm
                            	   750: 
                            	   751: .macro WAIT_HI_TWOGPIO_ONLY
                            	   752: .if TWOGPIO == 1
                            	   753:    HI_BITCLK
                            	   754: .endif
                            	   755: .endm
                            	   756: 
                            	   757: .macro LO_LRCLK
                            	   758: .if TWOGPIO == 1
                            	   759: waitLRCL2\@:
                            	   760:    HI_BITCLK
                            	   761:    LO_BITCLK_FOR_LR_BIT
                            	   762:    bne    waitLRCL2\@
                            	   763:    HI_BITCLK
                            	   764: .else
                            	   765: waitLRCL\@:
                            	   766:    WAIT_EDGE_FOR_LR_BIT
                            	   767:    bne    waitLRCL\@
                            	   768: .endif
                            	   769: .endm
                            	   770: 
                            	   771: 
                            	   772: .macro HI_LRCLK
                            	   773: .if TWOGPIO == 1
                            	   774: waitLRCH2\@:
                            	   775:    HI_BITCLK
                            	   776:    LO_BITCLK_FOR_LR_BIT
                            	   777:    beq    waitLRCH2\@
                            	   778:    HI_BITCLK
                            	   779: .else
                            	   780: waitLRCH\@:
                            	   781:    WAIT_EDGE_FOR_LR_BIT
                            	   782:    beq    waitLRCH\@
                            	   783: .endif
                            	   784: .endm
                            	   785: 
                            	   786: 
                            	   787: 
                            	   788: 
                            	   789: .macro IEC958_STATUS
                            	   790: 
                            	   791:     #byte 0 = 0x04   - bits 0-7,   bit 2 set   // consumer, PCM, no copyright, no pre-emphasis
                            	   792:     #byte 1 = 0x00   - bits 8-15                // category (general mode)
                            	   793:     #byte 2 = 0x00   - bits 16-23              // source number, take no account of channel number
                            	   794:     #byte 3 = 0x02   - bits 24-31  bit 25 set    // sampling frequency uchFS = 2 = 48000
                            	   795:     #byte 4 = 0xDB   - bits 32-39  0b1011 | (13 << 4) bits 1101 1011   bits 32, 33, 35, 36, 38, 39      // 24 bit sampl
                            	   796: 
                            	   797:     cmp    r6, 0
                            	   798:     oreq   r1, IEC958_B_FRAME_PREAMBLE
                            	   799:     cmp r6, (IEC958_STATUS_BYTES * 8)
                            	   800:     bge    no_status_bytes\@
                            	   801:     cmp   r6, 2
                            	   802:     cmpne r6, 25
                            	   803:     bseteq r1, 30
                            	   804:     sub   r6, 32
                            	   805:     cmp   r6, (32 - 32)
                            	   806:     cmpne r6, (33 - 32)
                            	   807:     cmpne r6, (35 - 32)
                            	   808:     cmpne r6, (36 - 32)
                            	   809:     cmpne r6, (38 - 32)
                            	   810:     cmpne r6, (39 - 32)
                            	   811:     bseteq r1, 30
                            	   812:     add   r6, 32
                            	   813: no_status_bytes\@:
                            	   814:     mov    r8, 0
                            	   815:     btst   r1, 31  #test existing parity count
                            	   816:     movne  r8, 1
                            	   817:     bclr   r1, 31
                            	   818: 
                            	   819:     btst   r1, 0
                            	   820:     addne  r8, 1
                            	   821:     btst   r1, 1
                            	   822:     addne  r8, 1
                            	   823:     btst   r1, 2
                            	   824:     addne  r8, 1
                            	   825:     btst   r1, 3
                            	   826:     addne  r8, 1
                            	   827:     btst   r1, 28
                            	   828:     addne  r8, 1
                            	   829:     btst   r1, 29
                            	   830:     addne  r8, 1
                            	   831:     btst   r1, 30
                            	   832:     addne  r8, 1
                            	   833: 
                            	   834:     btst   r8, 0
                            	   835:     bsetne r1, 31   # set parity bit count is odd
                            	   836: 
                            	   837: .endm
                            	   838: 
                            	   839: .macro WRITE
                            	   840:     st     r1, (r5)
                            	   841: #increment buffer pointer
                            	   842:     add    r5, 4
                            	   843:     cmp    r5, r14
                            	   844:     movge  r5, r13
                            	   845: .endm
                            	   846: 
                            	   847: SINGLE_WRITE_LEFT_RIGHT:
00:0000072E 95C145AF        	   848:    btst   r21, SMI_CTRL_BIT_MONO_RIGHT
00:00000732 01C08C08        	   849:    movne  r1, r12
00:00000736 01C00B08        	   850:    moveq  r1, r11
