00:0000074A 46C1D930        	    13M     cmpne r6, 25
00:0000074E 01C25E08        	    14M     bseteq r1, 30
00:00000752 C6E820000000    	    15M     sub   r6, 32
00:00000758 066A            	    16M     cmp   r6, (32 - 32)
00:0000075A 46C1C130        	    17M     cmpne r6, (33 - 32)
00:0000075E 46C1C330        	    18M     cmpne r6, (35 - 32)
