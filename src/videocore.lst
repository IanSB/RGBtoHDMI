                            	   863: .macro CHECK_UNDERRUN
                            	   864:    # check for underrun
                            	   865:    cmp    r9,0x10
                            	   866:    bne    not_empty\@             #only check once per frame
                            	   867:    btst   r2, REPEAT_SAMPLE
                            	   868:    bne    not_empty\@          #repeat pending
                            	   869: 
                            	   870:    btst   r21, SMI_CTRL_BIT_DMA
                            	   871:    beq  not_dma_underrun\@
                            	   872: 
                            	   873:    ld     r0, (r10) #get dma pointer
                            	   874:    sub    r3, r14, r13  #buffer size
                            	   875:    cmp    r5, r0
                            	   876:    subge  r1, r5, r0
                            	   877:    bge    got_offset_under\@
                            	   878:    sub    r1, r0, r5
                            	   879:    sub    r1, r3, r1
                            	   880: got_offset_under\@:
                            	   881:    lsr    r3, 1
                            	   882:    sub    r1, r3
                            	   883:    st     r1, SMI_DMA_OFFSET(r20)
                            	   884:    rsb    r1, 0
                            	   885:    cmp    r1, MAX_DMA_DRIFT_ERROR
                            	   886:    bgt    repeat_empty\@
                            	   887:    cmp    r1, MAX_DMA_DRIFT
                            	   888:    bgt    empty\@
                            	   889:    b      not_empty\@
                            	   890: 
                            	   891: not_dma_underrun\@:
                            	   892:    ld     r0, (r7)  #read MAI CTL
                            	   893:    btst   r0, HD_MAI_CTL_ERRORE
                            	   894:    bne    repeat_empty_ERRORE\@
                            	   895:    btst   r0, HD_MAI_CTL_EMPTY
                            	   896:    beq    not_empty\@
                            	   897: empty\@:
                            	   898:    btst   r21, SMI_CTRL_BIT_PLL_1
                            	   899:    beq    repeat_empty\@
                            	   900:    btst   r21, SMI_CTRL_BIT_PLL_0
                            	   901:    beq    use_slow_pll_empty\@
                            	   902: 
                            	   903: #   mov    r0, r19
                            	   904: #   sub    r0, PLL_OFFSET_FAST
                            	   905:    sub    r19, PLL_OFFSET_FAST
                            	   906:    mov    r0, r19
                            	   907:    or     r0, CM_PASSWORD
                            	   908:    st     r0, (r18)
                            	   909:    b      not_empty\@
                            	   910: 
                            	   911: use_slow_pll_empty\@:
                            	   912:    sub    r19, PLL_OFFSET_SLOW
                            	   913:    mov    r0, r19
                            	   914:    or     r0, CM_PASSWORD
                            	   915:    st     r0, (r18)
                            	   916:    b      not_empty\@
                            	   917: 
                            	   918: repeat_empty_ERRORE\@:
                            	   919:    mov    r0, (1 << HD_MAI_CTL_RST_MAI) | (1 << HD_MAI_CTL_ERRORF) | (1 << HD_MAI_CTL_ERRORE) | (1 << HD_MAI_CTL_DLATE)
                            	   920:    st     r0, (r7)    #clear ERRORE
                            	   921:    mov    r0, (1 << HD_MAI_CTL_ENABLE) | (2 << HD_MAI_CTL_CHNUM) | (1 << HD_MAI_CTL_WHOLSMP) | (1 << HD_MAI_CTL_CHALIGN
                            	   922:    st     r0, (r7)
                            	   923:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	   924: repeat_empty\@:
                            	   925:    bset   r2, REPEAT_SAMPLE
                            	   926:    add    r23, 0x10000
                            	   927:    bclr   r23, 31   #max 32767
                            	   928:    st     r23, SMI_DROP_REPEAT_COUNT(r20)
                            	   929: not_empty\@:
                            	   930: 
                            	   931: .endm
                            	   932: 
                            	   933: .macro CHECK_OVERRUN
                            	   934:    # check for overrun
                            	   935:    cmp    r9, 0x20           #only check once per frame
                            	   936:    bne    not_full\@
                            	   937:    btst   r2, DROP_SAMPLE
                            	   938:    bne    not_full\@    #drop pending
                            	   939:    btst   r21, SMI_CTRL_BIT_DMA
                            	   940:    beq  not_dma_overrun\@
                            	   941: 
                            	   942:    ld     r0, (r10) #get dma pointer
                            	   943:    sub    r3, r14, r13  #buffer size
                            	   944:    cmp    r5, r0
                            	   945:    subge  r1, r5, r0
                            	   946:    bge    got_offset_over\@
                            	   947:    sub    r1, r0, r5
                            	   948:    sub    r1, r3, r1
                            	   949: got_offset_over\@:
                            	   950:    lsr    r3, 1
                            	   951:    sub    r1, r3
                            	   952:    st     r1, SMI_DMA_OFFSET(r20)
                            	   953:    cmp    r1, MAX_DMA_DRIFT_ERROR
                            	   954:    bgt    drop_full\@
                            	   955:    cmp    r1, MAX_DMA_DRIFT
                            	   956:    bgt    full\@
                            	   957:    b      not_full\@
                            	   958: 
                            	   959: not_dma_overrun\@:
                            	   960:    ld     r0, (r7)  #read MAI CTL
                            	   961:    btst   r0, HD_MAI_CTL_ERRORF
                            	   962:    bne    drop_full_ERRORF\@
                            	   963:    btst   r0, HD_MAI_CTL_FULL
                            	   964:    beq    not_full\@
                            	   965: full\@:
                            	   966:    btst   r21, SMI_CTRL_BIT_PLL_1
                            	   967:    beq    drop_full\@
                            	   968:    btst   r21, SMI_CTRL_BIT_PLL_0
                            	   969:    beq    use_slow_pll_full\@
                            	   970: 
                            	   971: #   mov    r0, r19
                            	   972: #   add    r0, PLL_OFFSET_FAST
                            	   973:    add    r19, PLL_OFFSET_FAST
                            	   974:    mov    r0, r19
                            	   975:    or     r0, CM_PASSWORD
                            	   976:    st     r0, (r18)
                            	   977:    b      not_full\@
                            	   978: 
                            	   979: use_slow_pll_full\@:
                            	   980:    add    r19, PLL_OFFSET_SLOW
                            	   981:    mov    r0, r19
                            	   982:    or     r0, CM_PASSWORD
                            	   983:    st     r0, (r18)
                            	   984:    b      not_full\@
                            	   985: drop_full_ERRORF\@:
                            	   986:    mov    r0, (1 << HD_MAI_CTL_RST_MAI) | (1 << HD_MAI_CTL_ERRORF) | (1 << HD_MAI_CTL_ERRORE) | (1 << HD_MAI_CTL_DLATE)
                            	   987:    st     r0, (r7)    #clear ERRORF
                            	   988:    mov    r0, (1 << HD_MAI_CTL_ENABLE) | (2 << HD_MAI_CTL_CHNUM) | (1 << HD_MAI_CTL_WHOLSMP) | (1 << HD_MAI_CTL_CHALIGN
                            	   989:    st     r0, (r7)
                            	   990:    bl     SINGLE_WRITE_LEFT_RIGHT
                            	   991: drop_full\@:
                            	   992:    bset   r2, DROP_SAMPLE
                            	   993:    add    r23, 1
                            	   994:    bclr   r23, 15  #max 32767
                            	   995:    st     r23, SMI_DROP_REPEAT_COUNT(r20)
                            	   996: not_full\@:
                            	   997: 
                            	   998: .endm
