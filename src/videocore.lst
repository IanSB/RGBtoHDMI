                            	   791: .macro IEC958_STATUS
                            	   792: 
                            	   793:     #byte 0 = 0x04   - bits 0-7,   bit 2 set   // consumer, PCM, no copyright, no pre-emphasis
                            	   794:     #byte 1 = 0x00   - bits 8-15                // category (general mode)
                            	   795:     #byte 2 = 0x00   - bits 16-23              // source number, take no account of channel number
                            	   796:     #byte 3 = 0x02   - bits 24-31  bit 25 set    // sampling frequency uchFS = 2 = 48000
                            	   797:     #byte 4 = 0xDB   - bits 32-39  0b1011 | (13 << 4) bits 1101 1011   bits 32, 33, 35, 36, 38, 39      // 24 bit sampl
                            	   798: 
                            	   799:     cmp    r6, 0
                            	   800:     oreq   r1, IEC958_B_FRAME_PREAMBLE
                            	   801:     cmp r6, (IEC958_STATUS_BYTES * 8)
                            	   802:     bge    no_status_bytes\@
                            	   803:     cmp   r6, 2
                            	   804:     cmpne r6, 25
                            	   805:     bseteq r1, 30
                            	   806:     sub   r6, 32
                            	   807:     cmp   r6, (32 - 32)
                            	   808:     cmpne r6, (33 - 32)
                            	   809:     cmpne r6, (35 - 32)
                            	   810:     cmpne r6, (36 - 32)
                            	   811:     cmpne r6, (38 - 32)
                            	   812:     cmpne r6, (39 - 32)
                            	   813:     bseteq r1, 30
                            	   814:     add   r6, 32
                            	   815: no_status_bytes\@:
                            	   816:     mov    r8, 0
                            	   817:     btst   r1, 31  #test existing parity count
                            	   818:     movne  r8, 1
                            	   819:     bclr   r1, 31
                            	   820: 
                            	   821:     btst   r1, 0
                            	   822:     addne  r8, 1
                            	   823:     btst   r1, 1
                            	   824:     addne  r8, 1
                            	   825:     btst   r1, 2
                            	   826:     addne  r8, 1
                            	   827:     btst   r1, 3
                            	   828:     addne  r8, 1
                            	   829:     btst   r1, 28
                            	   830:     addne  r8, 1
                            	   831:     btst   r1, 29
                            	   832:     addne  r8, 1
                            	   833:     btst   r1, 30
                            	   834:     addne  r8, 1
                            	   835: 
                            	   836:     btst   r8, 0
                            	   837:     bsetne r1, 31   # set parity bit count is odd
                            	   838: 
                            	   839: .endm
                            	   840: 
                            	   841: .macro WRITE
                            	   842:     st     r1, (r5)
                            	   843: #increment buffer pointer
                            	   844:     add    r5, 4
                            	   845:     cmp    r5, r14
                            	   846:     movge  r5, r13
                            	   847: .endm
                            	   848: 
                            	   849: SINGLE_WRITE_LEFT_RIGHT:
00:0000072E 95C145AF        	   850:    btst   r21, SMI_CTRL_BIT_MONO_RIGHT
00:00000732 01C08C08        	   851:    movne  r1, r12
00:00000736 01C00B08        	   852:    moveq  r1, r11
