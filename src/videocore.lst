                            	  1026: skip_update\@:
                            	  1027: 
                            	  1028:    mov    r3, 4
                            	  1029: firstremain\@:
                            	  1030:    WAIT_FOR_DATA_BIT
                            	  1031:    sub    r3, 1
                            	  1032:    cmp    r3, 0
                            	  1033:    bne    firstremain\@
                            	  1034: 
                            	  1035:    cmp    r9, (BUFFER_CHECK_COUNT >> 1) + 0x10
